@page
@using VialambreAppTest1.Utility;
@model VialambreAppTest1.Pages.Briefs.Employee.Design.AsignadasModel
@{
}

<div class="container mt-1 mx-auto">
    <div class="card shadow-lg">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0">Cotizaciones asignadas</h4>
        </div>
        <div class="card-body">
            <form method="post">
                @if (Model.BriefAsignadosDesign?.Count() > 0)
                {
                 <div class="table-responsive">
                        <table id="briefscostos" class="table table-bordered table-hover table-striped">
                            <thead class="thead-dark">
                                <tr>
                                    <th scope="col" class="truncate col-sm-1">@Html.DisplayNameFor(m => m.BriefVM!.ElementAt(0).Consecutivo)</th>
                                    <th scope="col">@Html.DisplayNameFor(m => m.BriefVM!.ElementAt(0).ClientFullName)</th>
                                    <th scope="col">@Html.DisplayNameFor(m => m.BriefVM!.ElementAt(0).Title)</th>
                                    <th scope="col" class="truncate col-sm-1">@Html.DisplayNameFor(m => m.BriefVM!.ElementAt(0).CreateDate)</th>
                                    <th scope="col" class="truncate col-sm-1">@Html.DisplayNameFor(m => m.BriefVM!.ElementAt(0).FechaRequerida)</th>
                                    <th scope="col" class="truncate col-sm-1">@Html.DisplayNameFor(m => m.BriefVM!.ElementAt(0).DesignerAsignado)</th>
                                    <th scope="col" class="truncate col-sm-1">@Html.DisplayNameFor(m => m.BriefVM!.ElementAt(0).StatusDesign)</th>
                                    <th scope="col" class="truncate col-sm-1">@Html.DisplayNameFor(m => m.BriefVM!.ElementAt(0).CosteadorAsignado)</th>
                                    <th scope="col" class="truncate col-sm-1">@Html.DisplayNameFor(m => m.BriefVM!.ElementAt(0).StatusCostos)</th>
                                    <th scope="col" class="col-1">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var brief in Model.BriefAsignadosDesign)
                                {
                                    <tr>
                                        <td class="truncate">@brief.Consecutivo</td>
                                        <td class="truncate">@brief.ClientFullName</td>
                                        <td class="truncate">@brief.Title</td>
                                        <td class="truncate">@brief.CreateDate.ToString("dd/MM/yy")</td>
                                        <td class="truncate">@brief.FechaRequerida.ToString("dd/MM/yy")</td>
                                        <td class="truncate">@brief.DesignerAsignado</td>
                                        <td class="truncate status-@(brief.StatusDesign.ToString().ToLower() ?? "")">@brief.StatusDesign</td>
                                        <td class="truncate">@brief.CosteadorAsignado</td>
                                        <td class="truncate status-@(brief.StatusCostos.ToString().ToLower() ?? "")">@brief.StatusCostos</td>
                                        <td class="stylbtn">
                                            <div class="btn-group" role="group">
                                                <a asp-route-id="@brief.BriefId" asp-page="Details" title="Ver detalles del brief" class="btn btn-outline-info btn-sm"><i class="bi bi-eye-fill"></i></a>
                                                @if (brief.StatusDesign == BriefStatus.Pendiente)
                                                {
                                                    <a asp-route-briefid="@brief.BriefId" asp-page="/Briefs/Employee/Design/Aprobar" title="Entregar" class="btn btn-outline-success btn-sm"><i class="bi bi-check-lg"></i></a>
                                                    <a asp-route-briefid="@brief.BriefId" asp-page="/Briefs/Employee/Design/Rechazar" title="Rechazar" class="btn btn-outline-danger btn-sm"><i class="bi bi-x-lg"></i></a>
                                                    <a asp-route-briefid="@brief.BriefId" asp-page="/Briefs/Employee/Design/Reasignar" title="Reasignar"
                                                       class="btn btn-outline-warning btn-sm">
                                                        <i class="bi bi-arrow-clockwise"></i>
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                 </div>
                }
                else
                {
                    <p>No hay Briefs asignados</p>
                }
            </form>
        </div>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/jquery.dataTables.min.js"></script>
<script src="~/js/dataTables.bootstrap5.min.js"></script>
<script src="~/js/dataTablesConfig.js"></script>
<!-- Agregar el siguiente script para cambiar los estilos de acuerdo al estado -->
<script src="~/js/script.js" defer></script>
<script src="~/js/desing/reasignadasdesingn.js" defer></script>
<script src="~/js/desing/rechazadas.js" defer></script>
<script src="~/js/desing/entregadas.js" defer></script>
@if (Model.BriefAsignadosDesign?.Count() > 0)
{
        <script>
            $(document).ready(function () {
                var asignadasCount = @Model.BriefAsignadosDesign.Count();
                toastr.warning('¡Tienes ' + asignadasCount + ' Cotizaciones Asignadas!', 'Atención', { timeOut: 30000, positionClass: 'toast-top-center' });
            });
        </script>
}

