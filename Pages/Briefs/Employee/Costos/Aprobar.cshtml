@page
@model VialambreAppTest1.Pages.Briefs.Employee.Costos.AprobarModel
@{
}
<div class="card w-80 shadow-lg mt-3" style="margin:auto">
    <div class="card-header bg-info text-white" style="font-weight:bold;">
        <span style="font-size: 25px;">Propuesta de costos: @Model!.BriefDetails!.Consecutivo</span>
    </div>
    <form id="costosForm" method="post" enctype="multipart/form-data">
        <div class="card-body">
            <div class="row">
                <div class="mt-1">
                    <label for="Description">Respuesta:</label>

                    <div class="col-sm-12 mt-2">
                        <label asp-for="BriefVM!.ValorTotalCotizado" class="form-label">Valor Total Cotizado</label>
                        <input asp-for="BriefVM!.ValorTotalCotizado"
                               type="number"
                               step="0.01"
                               class="form-control col-sm-12"
                               placeholder="100000.00" />
                        <span asp-validation-for="BriefVM!.ValorTotalCotizado" class="text-danger"></span>
                    </div>

                    <textarea asp-for="BriefVM!.RespuestaCostos" class="form-control mt-2" rows="4" placeholder="Descripción de la cotización..." required></textarea>
                </div>
                <div class="mt-3">
                    <div class="col-sm-4">
                        <label>Archivo adjunto:</label>
                    </div>
                    <div>
                        <input asp-for="BriefVM!.FileRespCostos" type="file" name="FileRespCostos" class="form-control mt-2" required />
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer text-muted">
            <a asp-page="/Briefs/Employee/Costos/Asignadas" class="btn btn-secondary"><i class="bi bi-x-circle" style="color:white"></i> Cancelar</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle" style="color:white"></i> Enviar</button>
        </div>
    </form>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/jquery.dataTables.min.js"></script>
<script src="~/js/dataTables.bootstrap5.min.js"></script>
<script src="~/js/dataTablesConfig.js"></script>
<script src="~/lib/toastr/toastr.min.js"></script> <!-- Toastr JS -->