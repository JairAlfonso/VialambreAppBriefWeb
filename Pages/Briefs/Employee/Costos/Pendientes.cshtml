@page
@using VialambreAppTest1.Utility
@using Microsoft.AspNetCore.Mvc.RazorPages
@model VialambreAppTest1.Pages.Briefs.Employee.Costos.PendientesModel


@{
}

<div class="container mt-1 mx-auto">
    <div class="card shadow-lg">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0">Cotizaciones pendientes</h4>
        </div>
        <div class="card-body">
            <form method="post">
                @if (Model.CostosBriefs?.Count() > 0)
                {
                    <div class="table-responsive">
                        <table id="briefscostos" class="table table-bordered table-hover table-striped">
                            <thead class="thead-dark">
                                <tr>
                                    <th scope="col" class="truncate col-sm-1">@Html.DisplayNameFor(m => m.BriefsList!.First().Consecutivo)</th>
                                    <th scope="col" class="col-2">@Html.DisplayNameFor(m => m.BriefsList!.First().ClientFullName)</th>
                                    <th scope="col" class="col-2">@Html.DisplayNameFor(m => m.BriefsList!.First().Title)</th>
                                    <th scope="col" class="truncate col-sm-1">@Html.DisplayNameFor(m => m.BriefsList!.First().CreateDate)</th>
                                    <th scope="col" class="truncate col-sm-1">@Html.DisplayNameFor(m => m.BriefsList!.First().FechaRequerida)</th>
                                    <th scope="col" class="truncate col-sm-1">@Html.DisplayNameFor(m => m.BriefsList!.First().DesignerAsignado)</th>
                                    <th scope="col" class="truncate col-sm-1">@Html.DisplayNameFor(m => m.BriefsList!.First().StatusDesign)</th>
                                    <th scope="col" class="truncate col-sm-1">@Html.DisplayNameFor(m => m.BriefsList!.First().CosteadorAsignado)</th>
                                    <th scope="col" class="truncate col-sm-1">@Html.DisplayNameFor(m => m.BriefsList!.First().StatusCostos)</th>
                                    <th scope="col">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var brief in Model.CostosBriefs)
                                {
                                    if (brief.CosteadorAsignado != "No Requiere")
                                    {
                                        <tr>
                                            <td class="truncate">@brief.Consecutivo</td>
                                            <td class="truncate">@brief.ClientFullName</td>
                                            <td class="truncate">@brief.Title</td>
                                            <td class="truncate">@brief.CreateDate.ToString("d/MM/yy HH:mm")</td>
                                            <td class="truncate">@brief.FechaRequerida.ToString("d/MM/yy")</td>
                                            <td class="truncate">@brief.DesignerAsignado</td>
                                            <td class="truncate status-@(brief.StatusDesign.ToString().ToLower() ?? "")">@brief.StatusDesign</td>
                                            <td class="truncate">@brief.CosteadorAsignado</td>
                                            <td class="truncate status-@(brief.StatusCostos.ToString().ToLower() ?? "")">@brief.StatusCostos</td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a asp-route-Id="@brief.BriefId" asp-page="Details" title="Ver detalles del brief" 
                                                     class="btn btn-outline-info btn-sm"><i class="bi bi-eye-fill"></i></a>

                                                    @if (!brief.AsignadoCostos && (brief.StatusDesign == BriefStatus.Aceptado 
                                                          || brief.StatusDesign == BriefStatus.SinDiseño))
                                                    {
                                                    <a asp-route-id="@brief.BriefId" asp-page-handler="Asignar" title="Asignarme este brief" 
                                                     data-toastr-title="Asignación de brief" data-toastr-message="Se te ha asignado el brief @brief.Title" 
                                                     data-toastr-type="success" class="btn btn-outline-success btn-sm"><i class="bi bi-plus-lg"></i></a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-center">No hay Briefs pendientes</p>
                }
            </form>
        </div>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/jquery.dataTables.min.js"></script>
<script src="~/js/dataTables.bootstrap5.min.js"></script>
<script src="~/js/dataTablesConfig.js"></script>
<script src="~/lib/toastr/toastr.min.js"></script> <!-- Toastr JS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
<script src="~/js/script.js" defer></script>
<script src="~/js/desing/entregadas.js" defer></script>
@if (Model.CostosBriefs?.Count() > 0)
{
    <script>
        $(document).ready(function () {
            var pendientesCount = @Model.CostosBriefs.Count();
            toastr.warning('¡Tienes ' + pendientesCount + ' cotizacion pendiente!', 'Atención', { timeOut: 30000, positionClass: 'toast-top-center' });
        });
       
    </script>

}


