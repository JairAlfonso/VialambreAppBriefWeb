@page
@model VialambreAppTest1.Pages.Briefs.Admin.LugarEntregas.CreateModel
@{
}

<div class="card shadow-lg mx-auto mt-5" style="max-width: 500px;">
    <div class="card-header">
        <div class="row">
            <div class="col-sm-6 mt-2 mx-4">
                <h5 class="card-title fw-bold pt-2"><i class="bi bi-person-circle"> Nuevo lugar de entrega</i></h5>
            </div>
        </div>
    </div>
    <div class="container">
        <form method="post">
            <div class="mx-auto my-4 col-xl-8">
                <div class="mt-2">
                    <div class="">
                        <input asp-for="LugarEntrega!.Name" class="form-control" placeholder="Nombre del lugar de entrega" />
                    </div>
                    <span asp-validation-for="LugarEntrega!.Name" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary mt-2"><i class="bi bi-check-circle " style="color:white"></i> Crear</button>
                <a asp-page="/Briefs/Admin/LugarEntregas/Index" class="btn btn-secondary mt-2"><i class="bi bi-x-circle" style="color:white"></i> Cancelar</a>
            </div>
        </form>
    </div>
</div>