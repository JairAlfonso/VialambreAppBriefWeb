@page
@model VialambreAppTest1.Pages.Briefs.Admin.Cotizaciones.AprobadasModel
@{
}

<div class="wrapper" style="margin:auto;">
    <div class="card shadow-lg">
    <div class="card-header bg-info text-white" style="font-weight:bold;">
        <span style="font-size: 25px;">Cotizaciones Aprobadas</span>
</div>
            <div class="card-body">
            <div class="table-responsive">
                @if (Model.Briefs?.Count() > 0)
                {
                    <!-- Añade una clase table-responsive para hacer que la tabla sea responsive -->
                    <div class="table-responsive">
                        <table id="briefscostos" class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                    <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).Consecutivo)</th>
                                    <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).ClientFullName)</th>
                                    <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).Title)</th>
                                    <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).CreateDate)</th>
                                    <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).FechaRequerida)</th>
                                    <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).Design)</th>
                                    <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).StatusDesign)</th>
                                    <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).DesignerAsignado)</th>
                                    <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).FechaDesignAceptado)</th>
                                    <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).StatusCostos)</th>
                                    <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).CosteadorAsignado)</th>
                                    <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).FechaCostosAceptado)</th>
                      
                         <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var brief in Model.Briefs!)
                            {
                                <tr>
                                        <td class="truncate">@brief.Consecutivo</td>
                                        <td class="truncate">@brief.ClientFullName</td>
                                        <td class="truncate">@brief.Title</td>
                                        <td class="truncate">@brief.CreateDate</td>
                                        <td class="truncate">@brief.FechaRequerida</td>
                                        <td class ="truncate">
                                           @if (brief.Design == true)
                                            {
                                             <span>Si</span>
                                              }
                                            else
                                              {
                                           <span>No</span>
                                             }
                                         </td>
                                        <td class="truncate">@brief.StatusDesign</td>
                                        <td class="truncate">@brief.DesignerAsignado</td>
                                        <td class="truncate">@brief.FechaDesignAceptado</td>
                                        <td class="truncate">@brief.StatusCostos</td>
                                        <td class="truncate">@brief.CosteadorAsignado</td>
                                        <td class="truncate">@brief.FechaCostosAceptado</td>
                                   
                                    <td>
                                        <a asp-route-Id="@brief.BriefId" asp-page="Details" class="btn btn-outline-info p-1"><i class="bi bi-eye-fill"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                }
                else
                {
                    <p>No hay cotizaciones aprobadas</p>
                }
            </div>
        </div>
    </div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/jquery.dataTables.min.js"></script>
<script src="~/js/dataTables.bootstrap5.min.js"></script>
<script src="~/js/dataTablesConfig.js"></script>
<!-- Agregar el siguiente script para cambiar los estilos de acuerdo al estado -->
    <script src="~/js/script.js" defer></script>
    @if (Model.Briefs?.Count() > 0)
    {
        <script>
            $(document).ready(function () {
                var brief = @Model.Briefs.Count();
                toastr.warning('¡Tienes ' + brief + ' cotizacion aprobadas!', 'Atención', { timeOut: 50000, positionClass: 'toast-top-center' });
            });

        </script>

    }



