@page
@model VialambreAppTest1.Pages.Briefs.Admin.Cotizaciones.PendientesModel
@{
}

<div class="container mt-1 mx-auto">
    <div class="card shadow-lg">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0">Cotizaciones pendientes</h4>
        </div>
        <div class="card-body">
                @if (Model.Briefs?.Count() > 0)
                {
                <div class="table-responsive">
                    <table id="briefscostos" class="table table-bordered table-hover table-striped table-compact" >
                            <thead class="thead-dark">
                                <tr>
                                <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).Consecutivo)</th>
                                <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).ClientFullName)</th>
                                <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).Title)</th>
                                <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).CreateDate)</th>
                                <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).FechaRequerida)</th>
                                <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).Design)</th>
                                <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).StatusDesign)</th>
                                <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).DesignerAsignado)</th>
                                <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).FechaRespuestaDesign)</th>
                                <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).FechaDesignAceptado)</th>
                                <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).StatusCostos)</th>
                                <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).CosteadorAsignado)</th>
                                <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).FechaRespuestaCostos)</th>
                                <th scope="col" class="truncate">@Html.DisplayNameFor(m => m.BriefsList!.ElementAt(0).FechaCostosAceptado)</th>
                                <th class ="truncate">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var brief in Model.Briefs!)
                                {
                                    <tr>
                                    <td class="truncate">@brief.Consecutivo</td>
                                    <td class="truncate">@brief.ClientFullName</td>
                                    <td class="truncate">@brief.Title</td>
                                    <td class="truncate">@brief.CreateDate.ToString("d/MM/yy HH:mm")</td>
                                    <td class="truncate">@brief.FechaRequerida.ToString("d/MM/yy")</td>
                                        <td>
                                            @if (brief.Design == true)
                                            {
                                                <span>Si</span>
                                            }
                                            else
                                            {
                                                <span>No</span>
                                            }
                                        </td>
                                        <td class="status-@(brief.StatusDesign.ToString().ToLower() ?? "")">@brief.StatusDesign</td>
                                    <td class="truncate">@brief.DesignerAsignado</td>
                                    <td class="truncate">@brief.FechaRespuestaDesign</td>
                                    <td class="truncate">@brief.FechaDesignAceptado</td>
                                    <td class="status-@(brief.StatusCostos.ToString().ToLower() ?? "")">@brief.StatusCostos</td>
                                    <td class="truncate">@brief.CosteadorAsignado</td>
                                    <td class="truncate">@brief.FechaRespuestaCostos</td>
                                    <td class="truncate">@brief.FechaCostosAceptado</td>
                                        <td>
                                        <a asp-route-Id="@brief.BriefId" asp-page="/Briefs/Client/Details"
                                           class="btn btn-outline-info btn-sm p-1" title="Ver Detalles"><i class="bi bi-eye-fill"></i></a>


                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p>No hay cotizaciones pendientes</p>
                }
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/jquery.dataTables.min.js"></script>
    <script src="~/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/dataTablesConfig.js"></script>
    <script src="~/lib/toastr/toastr.min.js"></script> <!-- Toastr JS -->
    <!-- Agregar el siguiente script para cambiar los estilos de acuerdo al estado -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="~/js/script.js" defer></script>
@if (Model.Briefs?.Count() > 0)
{
    <script>
        $(function () {
            var pendientesCount = @Model.Briefs.Count(); // Asegúrate de que esto genere un número
            toastr.warning('¡Tienes ' + pendientesCount + ' cotización pendiente!', 'Atención', { timeOut: 50000, positionClass: 'toast-top-center' });
        });
    </script>
}