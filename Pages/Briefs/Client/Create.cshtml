@page
@model VialambreAppTest1.Pages.Briefs.Client.CreateModel
@attribute [RequestSizeLimitAttribute(268435456)]
@{
    Model!.BriefVM!.FechaRequerida = DateTime.Now;
}

<div class="card w-80 shadow-lg mt-3" style="margin:auto">
    <div class="card-header bg-info text-white" style="font-weight:bold;">

        <span style="font-size: 25px;">Nuevo Brief</span>

    </div>
    <form method="post" enctype="multipart/form-data">
        <div class="card-body">
            
            <div class="row">

                <fieldset class="col-sm-6">

                    <div class="divider-line mt-2">
                        <h5>Cliente </h5>
                    </div>

                    <div class="mt-1">

                        <div class="col-sm-3 mt-2">
                            <label for="FullName">Nombre:</label>
                        </div>
                        <div class="col-sm-12 mt-1">
                            <select id="clienteSelect" asp-for="BriefVM!.ClientFullName" class="form-control mt-2">
                                <option selected>--Seleccione un cliente--</option>
                                @foreach (var client in Model.GetClientes!)
                                {
                                    <option value="@client.Text" data-documento="@client.Value">@client.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-3 mt-2">
                            <label for="FullName">NIT/ID:</label>
                        </div>
                        <div>
                            <input asp-for="BriefVM!.ClientDocument" type="text" class="form-control mt-1" id="documentoCliente" readonly />
                        </div>

                    </div>

                </fieldset>

                <fieldset class="col-sm-6">

                    <div class="divider-line mt-2">
                        <h5 class="d-inline-flex">Nuevo cliente</h5>
                        <input asp-for="BriefVM!.AgregarNuevoCliente" name="AgregarNuevoCliente" class="form-check-input" type="checkbox" value="true" />
                    </div>

                    <div class="mt-1">
                        <label for="NewClientFullName">Nombre:</label>
                        <input asp-for="BriefVM!.NewClientFullName" type="text" id="NewClientFullName" class="form-control mt-2" />
                    </div>
                    <div class="mt-1">
                        <label for="NewClientDocument">NIT/ID:</label>
                        <input asp-for="BriefVM!.NewClientDocument" type="text" id="NewClientDocument" class="form-control mt-2" />
                    </div>

                </fieldset>               

                <div class="divider-line mt-5">
                    <h5>Detalles del brief</h5>
                </div>

                <fieldset class="col-sm-6">

                    <div class="row">

                        <div class="mt-1">
                            <div class="col-sm-4 mt-2">
                                <label asp-for="BriefVM!.TipoCotizacion"></label>
                            </div>
                            <div class="form-check form-check-inline mt-1">
                                <div>
                                    <label>Nueva</label>
                                    <input asp-for="BriefVM!.TipoCotizacion" class="form-check-input" type="radio" id="nuevaCotizacion" value="NuevaCotizacion">
                                </div>
                            </div>
                            <div class="form-check form-check-inline">
                                <div>
                                    <label>Montaje</label>
                                    <input asp-for="BriefVM!.TipoCotizacion" class="form-check-input" type="radio" id="montaje" value="Montaje">
                                </div>
                            </div>
                            <div class="form-check form-check-inline">
                                <div>
                                    <label>Licitacion</label>
                                    <input asp-for="BriefVM!.TipoCotizacion" class="form-check-input" type="radio" id="licitacion" value="Licitacion">

                            </div>
                               
                            </div>
                            <fieldset class="col-sm-2">

                                <div class="mt-3">
                                    <input asp-for="BriefVM!.HV" type="text" class="form-control mt-2" placeholder="HV" />
                                    <span asp-validation-for="BriefVM!.HV" class="text-danger"></span>
                                </div>

                            </fieldset>
                        </div>
                       
                    </div>

                    <div class="row">

                        <fieldset class="col-sm-6">

                            <div class="mt-3">
                                <input asp-for="BriefVM!.Title" type="text" class="form-control mt-2" placeholder="Nombre de la Campaña" />
                                <span asp-validation-for="BriefVM!.Title" class="text-danger"></span>
                            </div>
                   
                        </fieldset>

                        <fieldset class="col-sm-6">

                            <div class="mt-3">
                                <input asp-for="BriefVM!.Marca" type="text" class="form-control mt-2" placeholder="Nombre de la marca" />
                                <span asp-validation-for="BriefVM!.Marca" class="text-danger"></span>
                            </div>

                        </fieldset>

                    </div>

                    <div class="mt-1">
                        <textarea asp-for="BriefVM!.Description" class="form-control mt-2" rows="4" placeholder="Descripción..."></textarea>
                        <span asp-validation-for="BriefVM!.Description" class="text-danger"></span>
                    </div>

                    <div class="row">

                        <fieldset class="col-sm-6">

                            <div class="mt-4">
                                <div class="col-sm-6 mt-2">
                                    <label asp-for="BriefVM!.Producto"></label>
                                </div>
                                <div class="col-sm-12 mt-1">
                                    <select asp-for="BriefVM!.Producto" asp-items="Model.GetProducts" class="form-control"><option selected>--Seleccione producto--</option></select>
                                </div>
                                <div class="form-check form-check-inline mt-1">
                                    <input asp-for="BriefVM!.NewProducto" class="form-check-input" type="checkbox" id="newproduct" name="NewProduct" value="true">
                                    <label class="form-check-label" for="otro">Otro</label>
                                </div>
                                <div>
                                    <input asp-for="BriefVM!.ProductoInput" type="text" class="form-control mt-1" id="productInput" placeholder="¿Cuál?" />
                                </div>
                            </div>

                            <div>
                                <div class="col-sm-6 mt-3">
                                    <label asp-for="BriefVM!.EntregarEn"></label>
                                </div>
                                <div class="col-sm-12 mt-1">
                                    <select asp-for="BriefVM!.EntregarEn" asp-items="Model.GetLugarEntregas" class="form-control"><option selected>--Seleccione lugar de entrega--</option></select>
                                </div>
                                <div class="form-check form-check-inline mt-1">
                                    <input asp-for="BriefVM!.NewLugarEntrega" class="form-check-input" type="checkbox" id="newlugarentrega" name="NewLugarEntrega" value="true">
                                    <label class="form-check-label" for="otro">Otro</label>
                                </div>
                                <div>
                                    <input asp-for="BriefVM!.EntregarEnInput" type="text" class="form-control mt-1" id="lugarentregaInput" placeholder="¿Cuál?" />
                                </div>
                            </div>

                            <div class="mt-2">
                                <div class="col-sm-6 mt-3">
                                    <label asp-for="BriefVM!.FechaRequerida"></label>
                                </div>
                                <div>
                                    <input asp-for="BriefVM!.FechaRequerida" type="date" value="@Model.BriefVM!.FechaRequerida.ToString("dd/MM/yy")" class="form-control mt-1" />
                                </div>
                            </div>

                        </fieldset>

                        <fieldset class="col-sm-6">

                            <div class="divider-line mt-3">
                                <h5>Información suministrada:</h5>
                            </div>

                            <div>
                                <div class="form-check form-check">
                                    <label class="form-check-label" for="KeyVisual">KeyVisual</label>
                                    <input asp-for="BriefVM!.KeyVisual" name="KeyVisual" class="form-check-input" type="checkbox" id="keyvisual" />
                                </div>
                                <div class="form-check form-check">
                                    <label class="form-check-label" for="Artes">Artes</label>
                                    <input asp-for="BriefVM!.Artes" name="Artes" class="form-check-input" type="checkbox" id="artes" />
                                </div>
                                <div class="form-check form-check">
                                    <label class="form-check-label" for="Planos">Planos</label>
                                    <input asp-for="BriefVM!.Planos" name="Planos" class="form-check-input" type="checkbox" id="cromado" />
                                </div>
                                <div class="form-check form-check">
                                    <label class="form-check-label" for="Logos">Logos</label>
                                    <input asp-for="BriefVM!.Logos" name="Logos" class="form-check-input" type="checkbox" id="zincado" />
                                </div>
                                <div class="form-check form-check">
                                    <label class="form-check-label" for="Manualmarca">ManualMarca</label>
                                    <input asp-for="BriefVM!.ManualMarca" name="ManualMarca" class="form-check-input" type="checkbox" id="manualmarca" />
                                </div>
                                <div class="form-check form-check">
                                    <label class="form-check-label" for="Boceto">Boceto</label>
                                    <input asp-for="BriefVM!.Boceto" name="Boceto" type="checkbox" class="form-check-input" id="boceto" />
                                </div>
                                <div class="form-check form-check">
                                    <label class="form-check-label" for="Muestrafisica">Muestra Física</label>
                                    <input asp-for="BriefVM!.MuestraFisica" name="MuestraFisica" type="checkbox" class="form-check-input" id="muestragrafica" />
                                </div>
                                <div class="form-check form-check">
                                    <label class="form-check-label" for="Imagenreferencia">ImagenReferencia</label>
                                    <input asp-for="BriefVM!.ImagenReferencia" name="ImagenReferencia" type="checkbox" class="form-check-input" id="imagenreferencia" />
                                </div>
                                <div class="form-check form-check">
                                    <label class="form-check-label" for="Ninguna">Ningúna</label>
                                    <input asp-for="BriefVM!.Ninguna" name="Ninguna" type="checkbox" class="form-check-input" id="ninguna" />
                                </div>
                            </div>

                        </fieldset>

                    </div>

                    <div class="mt-3">
                        <textarea asp-for="BriefVM!.ComentariosAdicionales" class="form-control mt-2" rows="4" placeholder="Comentarios adicionales..."></textarea>
                    </div>
                    

                </fieldset>

                <fieldset class="col-sm-6 mb-4">

                    <div class="row">

                        <fieldset class="col-sm-6">

                            <div>
                                <div class="col-sm-6 mt-2">
                                    <label asp-for="BriefVM!.Design"></label>
                                </div>
                                <div class="form-check form-check-inline mt-1">
                                    <div>
                                        <label>Si</label>
                                        <input asp-for="BriefVM!.Design" class="form-check-input" type="radio" id="diseño" value="true">
                                    </div>
                                </div>
                                <div class="form-check form-check-inline">
                                    <div>
                                        <label>No</label>
                                        <input asp-for="BriefVM!.Design" class="form-check-input" type="radio" id="diseño" value="false">
                                    </div>
                                </div>
                            </div>

                            <div>
                                <div class="col-sm-6 mt-2">
                                    <label asp-for="BriefVM!.Costos"></label>
                                </div>
                                <div class="form-check form-check-inline mt-1">
                                    <div>
                                        <label>Si</label>
                                        <input asp-for="BriefVM!.Costos" class="form-check-input" type="radio" id="Costos" value="true">
                                    </div>
                                </div>
                                <div class="form-check form-check-inline">
                                    <div>
                                        <label>No</label>
                                        <input asp-for="BriefVM!.Costos" class="form-check-input" type="radio" id="Costos" value="false">
                                    </div>
                                </div>
                            </div>

                            <div>
                                <div class="col-sm-6 mt-3">
                                    <label asp-for="BriefVM!.Linea"></label>
                                </div>
                                <div class="form-check form-check-inline mt-1">
                                    <div>
                                        <label>Institucional</label>
                                        <input asp-for="BriefVM!.Linea" class="form-check-input" type="radio" id="institucional" value="Institucional">
                                    </div>
                                </div>
                                <div class="form-check form-check-inline">
                                    <div>
                                        <label>Retail</label>
                                        <input asp-for="BriefVM!.Linea" class="form-check-input" type="radio" id="retail" value="Retail">
                                    </div>
                                </div>
                                <div class="form-check form-check-inline">
                                    <div>
                                        <label>E-Commerce</label>
                                        <input asp-for="BriefVM!.Linea" class="form-check-input" type="radio" id="eCommerce" value="E-Commerce">
                                    </div>
                                </div>
                            </div>

                            <div>
                                <div class="col-sm-6 mt-3">
                                    <label asp-for="BriefVM!.UnidadesInput"></label>
                                </div>
                                <div class="col-sm-12 mt-1">
                                    <div class="form-check form-check-inline">
                                        <input asp-for="BriefVM!.EsCantidadUnica" class="form-check-input" type="checkbox" id="unica" name="EsCantidadUnica">
                                        <label class="form-check-label" for="unica">Cantidad única</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input asp-for="BriefVM!.EsEscala" class="form-check-input" type="checkbox" id="escala" name="EsEscala">
                                        <label class="form-check-label" for="escala">Escala</label>
                                    </div>
                                    <div>
                                        <input asp-for="BriefVM!.UnidadesInput" type="text" class="form-control mt-2" id="unidades" placeholder="Ingrese la cantidad de unidades" />
                                    </div>
                                    <div>
                                        <input asp-for="BriefVM!.EscalaInput" type="text" class="form-control mt-2" id="escalas" placeholder="Ingrese una escala ejm. 1-1000" />
                                    </div>
                                </div>
                            </div>

                            <div>
                                <div class="col-sm-12 mt-3">
                                    <div>
                                        <label asp-for="BriefVM!.PresupuestoUnidad"></label>
                                    </div>
                                    <div class="col-sm-12 mt-2">
                                        <input class="form-control col-sm-12" type="number" asp-for="BriefVM!.PresupuestoUnidad" placeholder="$100000" />
                                    </div>
                                    <div class="col-sm-12 mt-2">
                                        @* <label asp-for="BriefVM!.ValorTotalCotizado" class="form-label" type="hidden">Valor Total Cotizado</label> *@
                                        <input class="form-control col-sm-12" asp-for="BriefVM!.ValorTotalCotizado" placeholder="$100000" type="hidden" />
                                        @* <span asp-validation-for="BriefVM!.ValorTotalCotizado" class="text-danger"></span> *@
                                    </div>
                                </div>
                            </div>

                        </fieldset>

                        <fieldset class="col-sm-6">

                            <div>
                                <div class="col-sm-6 mt-2">
                                    <label asp-for="BriefVM!.Instalacion"></label>
                                </div>
                                <div class="form-check form-check-inline mt-1">
                                    <div>
                                        <label>Si</label>
                                        <input asp-for="BriefVM!.Instalacion" class="form-check-input" type="radio" id="instalacionSi" value="true">
                                    </div>
                                </div>
                                <div class="form-check form-check-inline">
                                    <div>
                                        <label>No</label>
                                        <input asp-for="BriefVM!.Instalacion" class="form-check-input" type="radio" id="instalacionNo" value="false">
                                    </div>
                                </div>
                                <div>
                                    <input asp-for="BriefVM!.DireccionInstalacion" type="text" class="form-control mt-2" id="direccioninstalacion" placeholder="Dirección de instalación" />
                                </div>
                            </div>

                            <div>
                                <div class="col-sm-6 mt-3">
                                    <label asp-for="BriefVM!.TipoEmpaque"></label>
                                </div>
                                <div class="col-sm-12 mt-1">
                                    <select asp-for="BriefVM!.TipoEmpaque" asp-items="Model.GetEmpaques" class="form-control"><option selected>--Seleccione empaque--</option></select>
                                </div>
                                <div class="form-check form-check-inline mt-1">
                                    <input asp-for="BriefVM!.NewEmpaque" class="form-check-input" type="checkbox" id="newempaque" name="NewEmpaque" value="true">
                                    <label class="form-check-label" for="otro">Otro</label>
                                </div>
                                <div>
                                    <input asp-for="BriefVM!.TipoEmpaqueInput" type="text" class="form-control p-1" id="empaqueInput" placeholder="Otro.." />
                                </div>
                            </div>

                            <div>
                                <div class="col-sm-6 mt-3">
                                    <label asp-for="BriefVM!.CanalVenta"></label>
                                </div>
                                <div class="col-sm-12 mt-1">
                                    <div class="form-check form-check-inline">
                                        <input asp-for="BriefVM!.CanalVenta" class="form-check-input" type="radio" id="moderno" name="canalVenta" value="Moderno">
                                        <label class="form-check-label" for="moderno">Moderno</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input asp-for="BriefVM!.CanalVenta" class="form-check-input" type="radio" id="tradicional" name="canalVenta" value="Tradicional">
                                        <label class="form-check-label" for="tradicional">Tradicional</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input asp-for="BriefVM!.EsCanalVenta" name="EsCanalVenta" class="form-check-input" type="checkbox" id="otrocanal" value="true">
                                        <label class="form-check-label" for="otro">Otro</label>
                                    </div>
                                    <div>
                                        <input asp-for="BriefVM!.CanalVentaInput" type="text" class="form-control mt-2" id="CanalVentaInput" placeholder="Otro..." />
                                    </div>
                                </div>
                            </div>

                        </fieldset>

                    </div>                                                         

                    <div class="mt-1">

                        <div>
                            <div class="col-sm-4 mt-1">
                                <label>Archivos para costos:</label>
                            </div>
                            <div class="form-check form-check-inline mt-1">
                                <input asp-for="BriefVM!.ArchivosCostosExist" class="form-check-input" type="radio" id="archivoscostossi" value="true">
                                <label class="form-check-label" for="otro">Si</label>
                            </div>
                            <div class="form-check form-check-inline mt-1">
                                <input asp-for="BriefVM!.ArchivosCostosExist" class="form-check-input" type="radio" id="archivoscostosno" value="false">
                                <label class="form-check-label" for="otro">No</label>
                            </div>
                            <div>
                                <input asp-for="BriefVM!.FileCostos" type="file" id="archivoscostosInput" class="form-control mt-2" onchange="DisplayArchivosCostos(event)" />
                                <div class="mt-3">
                                    <img src="" id="archivoscostosview" class="w-25 img-thumbnail" />
                                </div>
                            </div>
                        </div>

                        <div>
                            <div class="col-sm-4 mt-1">
                                <label>Archivos para diseño:</label>
                            </div>
                            <div class="form-check form-check-inline mt-1">
                                <input asp-for="BriefVM!.ArchivosDesignExist" class="form-check-input" type="radio" id="archivosdesignsi" value="true">
                                <label class="form-check-label" for="otro">Si</label>
                            </div>
                            <div class="form-check form-check-inline mt-1">
                                <input asp-for="BriefVM!.ArchivosDesignExist" class="form-check-input" type="radio" id="archivosdesignno" value="false">
                                <label class="form-check-label" for="otro">No</label>
                            </div>
                            <div>
                                <input asp-for="BriefVM!.FileDesign" type="file" id="archivosdesignInput" class="form-control mt-2" onchange="DisplayArchivosDesign(event)" />
                                <div class="mt-3">
                                    <img src="" id="archivosdesignview" class="w-25 img-thumbnail" />
                                </div>
                            </div>
                        </div>


                        <div>
                            <div class="col-sm-4 mt-1">
                                <label>Otros archivos:</label>
                            </div>
                            <div class="form-check form-check-inline mt-1">
                                <input asp-for="BriefVM!.ImageUrlExist" class="form-check-input" type="radio" id="otrosarchivossi" value="true">
                                <label class="form-check-label" for="otro">Si</label>
                            </div>
                            <div class="form-check form-check-inline mt-1">
                                <input asp-for="BriefVM!.ImageUrlExist" class="form-check-input" type="radio" id="otrosarchivosno" value="false">
                                <label class="form-check-label" for="otro">No</label>
                            </div>
                            <div>
                                <input asp-for="BriefVM!.FileOtros" type="file" id="otrosarchivosInput" class="form-control mt-2" onchange="OtrosArchivos(event)" />
                                <div class="mt-3">
                                    <img src="" id="otrosarchivosview" class="w-25 img-thumbnail" />
                                </div>
                            </div>
                        </div>

                    </div>

                </fieldset>               
                                                                              
            </div>

        </div>
        <div class="card-footer text-muted">

            <a asp-page="/Briefs/Client/Realizadas" class="btn btn-secondary"><i class="bi bi-x-circle" style="color:white"></i> Cancelar</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle" style="color:white"></i> Siguiente</button>
            
        </div>
    </form>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />

    @* //scripts para mostrar imagen previa *@

    <script type="text/javascript">
        function DisplayArchivosCostos(event) {
            var archivosCostosInput = document.getElementById('archivoscostosInput');
            var archivosCostosView = document.getElementById('archivoscostosview');

            archivosCostosView.src = URL.createObjectURL(archivosCostosInput.files[0]);
        }
    </script>

    <script type="text/javascript">
        function DisplayArchivosDesign(event) {
            var archivosDesignInput = document.getElementById('archivosdesignInput');
            var archivosDesignView = document.getElementById('archivosdesignview');

            archivosDesignView.src = URL.createObjectURL(archivosDesignInput.files[0]);
        }
    </script>

    <script type="text/javascript">
        function OtrosArchivos(event) {
            var OtrosarchivosInput = document.getElementById('otrosarchivosInput');
            var OtrosarchivosView = document.getElementById('otrosarchivosview');

            OtrosarchivosView.src = URL.createObjectURL(OtrosarchivosInput.files[0]);
        }
    </script>
       

    <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", function () {
            var unidadesInput = document.getElementById("unidades");
            var escalasInput = document.getElementById("escalas");
            var unicaRadio = document.getElementById("unica");
            var escalaRadio = document.getElementById("escala");

            // Ocultar el campo de entrada al cargar la página
            //unidadesInput.style.display = "none";
            escalasInput.style.display = "none";

            // Manejar eventos de cambio en los radios
            unicaRadio.addEventListener("change", function () {
                unidadesInput.style.display = this.checked ? "block" : "none";
                escalasInput.style.display = this.checked ? "none" : "block";
                if (this.checked) {
                    escalaRadio.checked = false;
                }
            });

            escalaRadio.addEventListener("change", function () {
                escalasInput.style.display = this.checked ? "block" : "none";
                unidadesInput.style.display = this.checked ? "none" : "block";
                if (this.checked) {
                    unicaRadio.checked = false;
                }
            });
        });
    </script>

    <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", function () {

            var CanalVentaInput = document.getElementById("CanalVentaInput");
            var otroCanal = document.getElementById("otrocanal");

            // Ocultar el campo de entrada al cargar la página
            //CanalVentaInput.style.display = "none";

            // Manejar eventos de cambio en los radios
            otroCanal.addEventListener("change", function () {
                CanalVentaInput.style.display = this.checked ? "block" : "none";
            });
        });
    </script>

    <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", function () {

            var productInput = document.getElementById("productInput");
            var newproduct = document.getElementById("newproduct");

            // Ocultar el campo de entrada al cargar la página
            productInput.style.display = "none";

            // Manejar eventos de cambio en los radios
            newproduct.addEventListener("change", function () {
                productInput.style.display = this.checked ? "block" : "none";
