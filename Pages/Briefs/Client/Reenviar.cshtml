    @* //Otros scripts *@

    <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", function () {
            var unidadesInput = document.getElementById("unidades");
            var escalasInput = document.getElementById("escalas");
            var unicaRadio = document.getElementById("unica");
            var escalaRadio = document.getElementById("escala");

            // Ocultar el campo de entrada al cargar la página
            unidadesInput.style.display = "none";
            escalasInput.style.display = "none";

            // Verificar el estado inicial de los radios y mostrar u ocultar los campos en consecuencia
            if (unicaRadio.checked) {
                unidadesInput.style.display = "block";
                escalasInput.style.display = "none";
            } else if (escalaRadio.checked) {
                escalasInput.style.display = "block";
                unidadesInput.style.display = "none";
            }

            // Manejar eventos de cambio en los radios
            unicaRadio.addEventListener("change", function () {
                unidadesInput.style.display = this.checked ? "block" : "none";
                escalasInput.style.display = this.checked ? "none" : "block";
                if (this.checked) {
                    escalaRadio.checked = false;
                }
            });

            escalaRadio.addEventListener("change", function () {
                escalasInput.style.display = this.checked ? "block" : "none";
                unidadesInput.style.display = this.checked ? "none" : "block";
                if (this.checked) {
                    unicaRadio.checked = false;
                }
            });
        });
    </script>

