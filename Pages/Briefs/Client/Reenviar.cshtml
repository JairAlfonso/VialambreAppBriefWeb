@page
@model VialambreAppTest1.Pages.Briefs.Client.ReenviarModel
@{
}

<div class="card w-80 shadow-lg mt-3" style="margin:auto">
    <div class="card-header bg-info text-white" style="font-weight:bold;">

        <span style="font-size: 25px;">Reenviar brief: @Model!.BriefDetails!.Consecutivo </span>

    </div>
    <form method="post" enctype="multipart/form-data">
        <div class="card-body">

            <div class="row">

                <div class="divider-line mt-2">
                    <h5>Información del cliente</h5>
                </div>
                <fieldset class="col-sm-6">

                    <div class="mt-1">
                        <label for="FullName">Nombre:</label>
                        <input asp-for="BriefDetails!.ClientFullName" type="text" id="FullName" class="form-control mt-2" readonly />
                    </div>

                </fieldset>

                <fieldset class="col-sm-6">

                    <div class="mt-1">
                        <label for="Document">NIT/ID:</label>
                        <input asp-for="BriefDetails!.ClientDocument" type="text" id="Document" class="form-control mt-2" readonly />
                    </div>

                </fieldset>

                <div class="divider-line mt-5">
                    <h5>Detalles del brief</h5>
                </div>

                <fieldset class="col-sm-6">

                    <div class="mt-1">
                        <div class="col-sm-4 mt-2">
                            <label asp-for="BriefDetails!.TipoCotizacion"></label>
                        </div>
                        <div class="form-check form-check-inline mt-1">
                            <div>
                                <label>Nueva</label>
                                <input asp-for="BriefDetails!.TipoCotizacion" class="form-check-input" type="radio" id="nuevaCotizacion" value="NuevaCotizacion">
                            </div>
                        </div>
                        <div class="form-check form-check-inline">
                            <div>
                                <label>Montaje</label>
                                <input asp-for="BriefDetails!.TipoCotizacion" class="form-check-input" type="radio" id="montaje" value="Montaje">
                            </div>
                        </div>
                        <div class="form-check form-check-inline">
                            <div>
                                <label>Licitacion</label>
                                <input asp-for="BriefDetails!.TipoCotizacion" class="form-check-input" type="radio" id="licitacion" value="Licitacion">
                            </div>
                        </div>
                    </div>

                    <div class="row">

                        <fieldset class="col-sm-6">

                            <div class="mt-6">
                                <input asp-for="BriefDetails!.Title" type="text" class="form-control mt-2" placeholder="Nombre de la Campaña" />
                                <span asp-validation-for="BriefDetails!.Title" class="text-danger"></span>
                            </div>

                        </fieldset>

                        <fieldset class="col-sm-6">

                            <div class="mt-1">
                                <input asp-for="BriefDetails!.Marca" type="text" class="form-control mt-2" placeholder="Nombre de la marca" />
                                <span asp-validation-for="BriefDetails!.Marca" class="text-danger"></span>
                            </div>

                        </fieldset>

                    </div>

                    <div class="mt-1">
                        <textarea asp-for="BriefDetails!.Description" class="form-control mt-2" rows="4" placeholder="Descripción..."></textarea>
                    </div>

                    <div class="row">

                        <fieldset class="col-sm-6">

                            <div class="mt-1">
                                <div class="col-sm-6 mt-2">
                                    <label asp-for="BriefDetails!.Producto"></label>
                                </div>
                                <div class="col-sm-12 mt-1">
                                    <select asp-for="BriefDetails!.Producto" asp-items="Model.GetProducts" class="form-control"><option selected>--Seleccione producto--</option></select>
                                </div>
                                <div class="form-check form-check-inline mt-1">
                                    <input asp-for="BriefDetails!.NewProducto" class="form-check-input" type="checkbox" id="newproduct" name="NewProduct" value="true">
                                    <label class="form-check-label" for="otro">Otro</label>
                                </div>
                                <div>
                                    <input asp-for="BriefDetails!.ProductoInput" type="text" class="form-control mt-1" id="productInput" placeholder="¿Cuál?" />
                                </div>
                            </div>

                        </fieldset>

                        <fieldset class="col-sm-6">

                            <div class="mt-1">
                                <div class="col-sm-6 mt-2">
                                    <label asp-for="BriefDetails!.FechaRequerida"></label>
                                </div>
                                <div>
                                    <input asp-for="BriefDetails!.FechaRequerida" type="date" class="form-control mt-1" />
                                </div>
                            </div>

                        </fieldset>

                    </div>


                    <div class="row">

                        <fieldset class="col-sm-6">

                            <div>
                                <div class="col-sm-6 mt-2">
                                    <label asp-for="BriefDetails!.EntregarEn"></label>
                                </div>
                                <div class="col-sm-12 mt-1">
                                    <select asp-for="BriefDetails!.EntregarEn" asp-items="Model.GetLugarEntregas" class="form-control"><option selected>--Seleccione lugar de entrega--</option></select>
                                </div>
                                <div class="form-check form-check-inline mt-1">
                                    <input asp-for="BriefDetails!.NewLugarEntrega" class="form-check-input" type="checkbox" id="newlugarentrega" name="NewLugarEntrega" value="true">
                                    <label class="form-check-label" for="otro">Otro</label>
                                </div>
                                <div>
                                    <input asp-for="BriefDetails!.EntregarEnInput" type="text" class="form-control mt-1" id="lugarentregaInput" placeholder="¿Cuál?" />
                                </div>
                            </div>

                            <div class="mt-2">
                                <textarea asp-for="BriefDetails!.ComentariosAdicionales" class="form-control mt-2" rows="6" placeholder="Comentarios adicionales..."></textarea>
                            </div>

                        </fieldset>

                        <fieldset class="col-sm-6">

                            <div class="divider-line mt-1">
                                <h5>Información suministrada:</h5>
                            </div>
                            <div>
                                <div class="form-check form-check">
                                    <label class="form-check-label" for="KeyVisual">KeyVisual</label>
                                    <input asp-for="BriefDetails!.KeyVisual" name="KeyVisual" class="form-check-input" type="checkbox" id="keyvisual" />
                                </div>
                                <div class="form-check form-check">
                                    <label class="form-check-label" for="Artes">Artes</label>
                                    <input asp-for="BriefDetails!.Artes" name="Artes" class="form-check-input" type="checkbox" id="artes" />
                                </div>
                                <div class="form-check form-check">
                                    <label class="form-check-label" for="Planos">Planos</label>
                                    <input asp-for="BriefDetails!.Planos" name="Planos" class="form-check-input" type="checkbox" id="cromado" />
                                </div>
                                <div class="form-check form-check">
                                    <label class="form-check-label" for="Logos">Logos</label>
                                    <input asp-for="BriefDetails!.Logos" name="Logos" class="form-check-input" type="checkbox" id="zincado" />
                                </div>
                                <div class="form-check form-check">
                                    <label class="form-check-label" for="Manualmarca">ManualMarca</label>
                                    <input asp-for="BriefDetails!.ManualMarca" name="ManualMarca" class="form-check-input" type="checkbox" id="manualmarca" />
                                </div>
                                <div class="form-check form-check">
                                    <label class="form-check-label" for="Boceto">Boceto</label>
                                    <input asp-for="BriefDetails!.Boceto" name="Boceto" type="checkbox" class="form-check-input" id="boceto" />
                                </div>
                                <div class="form-check form-check">
                                    <label class="form-check-label" for="Muestrafisica">MuestraFisica</label>
                                    <input asp-for="BriefDetails!.MuestraFisica" name="MuestraFisica" type="checkbox" class="form-check-input" id="muestragrafica" />
                                </div>
                                <div class="form-check form-check">
                                    <label class="form-check-label" for="Imagenreferencia">ImagenReferencia</label>
                                    <input asp-for="BriefDetails!.ImagenReferencia" name="ImagenReferencia" type="checkbox" class="form-check-input" id="imagenreferencia" />
                                </div>
                                <div class="form-check form-check">
                                    <label class="form-check-label" for="Ninguna">Ningúna</label>
                                    <input asp-for="BriefDetails!.Ninguna" name="Ninguna" type="checkbox" class="form-check-input" id="ninguna" />
                                </div>
                            </div>

                        </fieldset>

                    </div>


                </fieldset>

                <fieldset class="col-sm-6">

                    <div class="row">

                        <fieldset class="col-sm-6">

                            <div>
                                <div class="col-sm-6 mt-2">
                                    <label asp-for="BriefDetails!.Design"></label>
                                </div>
                                <div class="form-check form-check-inline mt-1">
                                    <div>
                                        <label>Si</label>
                                        <input asp-for="BriefDetails!.Design" class="form-check-input" type="radio" id="diseño" value="true">
                                    </div>
                                </div>
                                <div class="form-check form-check-inline">
                                    <div>
                                        <label>No</label>
                                        <input asp-for="BriefDetails!.Design" class="form-check-input" type="radio" id="diseño" value="false">
                                    </div>
                                </div>
                            </div>

                        </fieldset>

                        <fieldset class="col-sm-6">

                            <div>
                                <div class="col-sm-6 mt-2">
                                    <label asp-for="BriefDetails!.Costos"></label>
                                </div>
                                <div class="form-check form-check-inline mt-1">
                                    <div>
                                        <label>Si</label>
                                        <input asp-for="BriefDetails!.Costos" class="form-check-input" type="radio" id="Costos" value="true">
                                    </div>
                                </div>
                                <div class="form-check form-check-inline">
                                    <div>
                                        <label>No</label>
                                        <input asp-for="BriefDetails!.Costos" class="form-check-input" type="radio" id="Costos" value="false">
                                    </div>
                                </div>
                            </div>

                        </fieldset>

                        <fieldset class="col-sm-6">

                            <div>
                                <div class="col-sm-6 mt-2">
                                    <label asp-for="BriefDetails!.Linea"></label>
                                </div>
                                <div class="form-check form-check-inline mt-1">
                                    <div>
                                        <label>Institucional</label>
                                        <input asp-for="BriefDetails!.Linea" class="form-check-input" type="radio" id="institucional" value="Institucional">
                                    </div>
                                </div>
                                <div class="form-check form-check-inline">
                                    <div>
                                        <label>Retail</label>
                                        <input asp-for="BriefDetails!.Linea" class="form-check-input" type="radio" id="retail" value="Retail">
                                    </div>
                                </div>
                                <div class="form-check form-check-inline">
                                    <div>
                                        <label>E-Commerce</label>
                                        <input asp-for="BriefDetails!.Linea" class="form-check-input" type="radio" id="eCommerce" value="E-Commerce">
                                    </div>
                                </div>
                            </div>

                        </fieldset>                                               

                    </div>                    

                    <div class="row">

                        <fieldset class="col-sm-6">

                            <div>
                                <div class="col-sm-6 mt-2">
                                    <label asp-for="BriefDetails!.UnidadesInput"></label>
                                </div>
                                <div class="col-sm-12 mt-1">
                                    <div class="form-check form-check-inline">
                                        <input asp-for="BriefDetails!.EsCantidadUnica" name="EsCantidadUnica" class="form-check-input" type="checkbox" id="unica">
                                        <label class="form-check-label" for="unica">Cantidad única</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input asp-for="BriefDetails!.EsEscala" name="EsEscala" class="form-check-input" type="checkbox" id="escala">
                                        <label class="form-check-label" for="escala">Escala</label>
                                    </div>
                                    <div>
                                        <input asp-for="BriefDetails!.UnidadesInput" type="text" class="form-control mt-2" id="unidades" placeholder="Ingrese la cantidad de unidades" />
                                    </div>
                                    <div>
                                        <input asp-for="BriefDetails!.EscalaInput" type="text" class="form-control mt-2" id="escalas" placeholder="Ingrese una escala ejm. 1-1000" />
                                    </div>
                                </div>
                            </div>

                        </fieldset>

                        <fieldset class="col-sm-6">

                            <div>
                                <div class="col-sm-6 mt-2">
                                    <label asp-for="BriefDetails!.Instalacion"></label>
                                </div>
                                <div class="form-check form-check-inline mt-1">
                                    <div>
                                        <label>Si</label>
                                        <input asp-for="BriefDetails!.Instalacion" class="form-check-input" type="radio" id="instalacionSi" value="true">
                                    </div>
                                </div>
                                <div class="form-check form-check-inline">
                                    <div>
                                        <label>No</label>
                                        <input asp-for="BriefDetails!.Instalacion" class="form-check-input" type="radio" id="instalacionNo" value="false">
                                    </div>
                                </div>
                                <div>
                                    <input asp-for="BriefDetails!.DireccionInstalacion" type="text" class="form-control mt-2" id="direccioninstalacion" placeholder="Dirección de instalación" />
                                </div>
                            </div>

                        </fieldset>

                    </div>                   

                    <div class="row">

                        <fieldset class="col-sm-6">

                            <div>
                                <div class="col-sm-6 mt-2">
                                    <label asp-for="BriefDetails!.CanalVenta"></label>
                                </div>
                                <div class="col-sm-12 mt-1">
                                    <div class="form-check form-check-inline">
                                        <input asp-for="BriefDetails!.CanalVenta" class="form-check-input" type="radio" id="moderno" value="Moderno">
                                        <label class="form-check-label" for="moderno">Moderno</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input asp-for="BriefDetails!.CanalVenta" class="form-check-input" type="radio" id="tradicional" value="Tradicional">
                                        <label class="form-check-label" for="tradicional">Tradicional</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input asp-for="BriefDetails!.EsCanalVenta" name="EsCanalVenta" class="form-check-input" type="checkbox" id="otrocanal" value="true">
                                        <label class="form-check-label" for="otro">Otro</label>
                                    </div>
                                    <div>
                                        <input asp-for="BriefDetails!.CanalVentaInput" type="text" class="form-control mt-2" id="CanalVentaInput" placeholder="¿Cuál?" />
                                    </div>
                                </div>
                            </div>

                        </fieldset>

                        <fieldset class="col-sm-6">

                            <div>
                                <div class="col-sm-12 mt-2">
                                    <div>
                                        <label asp-for="BriefDetails!.PresupuestoUnidad"></label>
                                    </div>
                                    <div class="col-sm-12 mt-1">
                                        <input class="form-control col-sm-12" type="number" asp-for="BriefDetails!.PresupuestoUnidad" placeholder="$100000" />
                                    </div>
                                </div>
                            </div>

                        </fieldset>
                        <fieldset class="col-sm-6">

                            <div>
                                @* <div class="col-sm-12 mt-2">
                                    <div>
                                        <label asp-for="BriefVM!.ValorTotalCotizado"></label>
                                    </div>
                                    <div class="col-sm-12 mt-1">
                                        <input class="form-control col-sm-12"
                                               type="number"
                                               asp-for="BriefVM!.ValorTotalCotizado"
                                               placeholder="$100000"
                                               step="1"
                                               min="0"
                                               inputmode="numeric"
                                               pattern="\d*" />
                                    </div>
                                    <span asp-validation-for="BriefVM!.ValorTotalCotizado" class="text-danger"></span>
                                </div> *@
                            </div>

                        </fieldset>

                    </div>

                    <div>
                        <div class="col-sm-3 mt-2">
                            <label asp-for="BriefDetails!.TipoEmpaque"></label>
                        </div>
                        <div class="col-sm-12 mt-1">
                            <select asp-for="BriefDetails!.TipoEmpaque" asp-items="Model.GetEmpaques" class="form-control"><option selected>--Seleccione empaque--</option></select>
                        </div>
                        <div class="form-check form-check-inline mt-1">
                            <input asp-for="BriefDetails!.NewEmpaque" class="form-check-input" type="checkbox" id="newempaque" name="NewEmpaque" value="true">
                            <label class="form-check-label" for="otro">Otro</label>
                        </div>
                        <div>
                            <input asp-for="BriefDetails!.TipoEmpaqueInput" type="text" class="form-control mt-1" id="empaqueInput" placeholder="¿Cuál?" />
                        </div>
                    </div>

                    <div>
                        <div class="col-sm-4 mt-2">
                            <label>Archivos para costos:</label>
                        </div>
                        @if (Model.BriefDetails!.ArchivosCostosExist == true && Model.BriefDetails!.ArchivosCostos != null)
                        {
                            <div class="form-check form-check-inline mt-1">
                                <input asp-for="BriefDetails!.ArchivosCostosExist" name="ArchivosCostosExist" class="form-check-input" type="radio" id="archivoscostossi" value="true">
                                <label class="form-check-label" for="otro">Si</label>
                            </div>
                            <div class="form-check form-check-inline mt-1">
                                <input asp-for="BriefDetails!.ArchivosCostosExist" name="ArchivosCostosExist" class="form-check-input" type="radio" id="archivoscostosno" value="false">
                                <label class="form-check-label" for="otro">No</label>
                            </div>
                            <div>
                                @* <a href="@Model!.BriefDetails!.ArchivosCostos" target="_blank">Ver archivo</a> *@
                                <a href="~/@Model!.BriefDetails!.ArchivosCostos" target="_blank">Ver archivo</a>
                                <a asp-page-handler="EliminarArchivoCostos" asp-route-id="@Model!.BriefDetails!.BriefId">Eliminar</a>
                            </div>
                            <input asp-for="BriefDetails!.ArchivosCostos" type="text" class="form-control mt-2" value="@Model!.BriefDetails!.ArchivosCostos" hidden />
                        }
                        else
                        {
                            <div class="form-check form-check-inline mt-1">
                                <input asp-for="BriefDetails!.ArchivosCostosExist" name="ArchivosCostosExist" class="form-check-input" type="radio" id="archivoscostossi" value="true">
                                <label class="form-check-label" for="otro">Si</label>
                            </div>
                            <div class="form-check form-check-inline mt-1">
                                <input asp-for="BriefDetails!.ArchivosCostosExist" name="ArchivosCostosExist" class="form-check-input" type="radio" id="archivoscostosno" value="false">
                                <label class="form-check-label" for="otro">No</label>
                            </div>
                            <div>
                                <input asp-for="BriefDetails!.FileCostos" type="file" id="archivoscostosInput" class="form-control mt-2" onchange="DisplayArchivosCostos(event)" />
                                <div class="mt-3">
                                    <img src="" id="archivoscostosview" class="w-25 img-thumbnail" />
                                </div>
                            </div>
                        }

                    </div>

                    <div>
                        <div class="col-sm-4 mt-2">
                            <label>Archivos para diseño:</label>
                        </div>
                        @if (Model.BriefDetails!.ArchivosDesignExist == true && Model.BriefVM!.ArchivosDesign != null)
                        {
                            <div class="form-check form-check-inline mt-1">
                                <input asp-for="BriefDetails!.ArchivosDesignExist" name="ArchivosDesignExist" class="form-check-input" type="radio" id="archivosdesignsi" value="true">
                                <label class="form-check-label" for="otro">Si</label>
                            </div>
                            <div class="form-check form-check-inline mt-1">
                                <input asp-for="BriefDetails!.ArchivosDesignExist" name="ArchivosDesignExist" class="form-check-input" type="radio" id="archivosdesignno" value="false">
                                <label class="form-check-label" for="otro">No</label>
                            </div>
                            <div>
                                @* <a href="@Model!.BriefDetails!.ArchivosDesign" target="_blank">Ver archivo</a> *@
                                <a href="~/@Model!.BriefDetails!.ArchivosDesign" target="_blank">Ver archivo</a>
                                <a asp-page-handler="EliminarArchivoDesign" asp-route-id="@Model!.BriefDetails!.BriefId">Eliminar</a>
                            </div>
                            <input asp-for="BriefDetails!.ArchivosDesign" type="text" class="form-control mt-2" value="@Model!.BriefDetails!.ArchivosDesign" hidden />
                        }
                        else
                        {
                            <div class="form-check form-check-inline mt-1">
                                <input asp-for="BriefDetails!.ArchivosDesignExist" name="ArchivosDesignExist" class="form-check-input" type="radio" id="archivosdesignsi" value="true">
                                <label class="form-check-label" for="otro">Si</label>
                            </div>
                            <div class="form-check form-check-inline mt-1">
                                <input asp-for="BriefDetails!.ArchivosDesignExist" name="ArchivosDesignExist" class="form-check-input" type="radio" id="archivosdesignno" value="false">
                                <label class="form-check-label" for="otro">No</label>
                            </div>
                            <div>
                                <input asp-for="BriefDetails!.FileDesign" type="file" id="archivosdesignInput" class="form-control mt-2" onchange="DisplayArchivosDesign(event)" />
                                <div class="mt-3">
                                    <img src="" id="archivosdesignview" class="w-25 img-thumbnail" />
                                </div>
                            </div>
                        }
                    </div>

                    <div>
                        <div class="col-sm-4 mt-2">
                            <label>Otros archivos:</label>
                        </div>
                        @if (Model.BriefDetails!.ImageUrlExist == true && Model.BriefDetails!.ImageUrl != null)
                        {
                            <div class="form-check form-check-inline mt-1">
                                <input asp-for="BriefDetails!.ImageUrlExist" name="ImageUrlExist" class="form-check-input" type="radio" id="otrosarchivossi" value="true">
                                <label class="form-check-label" for="otro">Si</label>
                            </div>
                            <div class="form-check form-check-inline mt-1">
                                <input asp-for="BriefDetails!.ImageUrlExist" name="ImageUrlExist" class="form-check-input" type="radio" id="otrosarchivosno" value="false">
                                <label class="form-check-label" for="otro">No</label>
                            </div>
                            <div>
                                @* <a href="@Model!.BriefDetails!.ImageUrl" target="_blank">Ver archivo</a> *@
                                <a href="~/@Model!.BriefDetails!.ImageUrl" target="_blank">Ver archivo</a>
                                <a asp-page-handler="EliminarArchivoOtros" asp-route-id="@Model!.BriefDetails!.BriefId">Eliminar</a>
                            </div>
                            <input asp-for="BriefDetails!.ImageUrl" type="text" class="form-control mt-2" value="@Model!.BriefDetails!.ImageUrl" hidden />
                        }
                        else
                        {
                            <div class="form-check form-check-inline mt-1">
                                <input asp-for="BriefDetails!.ImageUrlExist" name="ImageUrlExist" class="form-check-input" type="radio" id="otrosarchivossi" value="true">
                                <label class="form-check-label" for="otro">Si</label>
                            </div>
                            <div class="form-check form-check-inline mt-1">
                                <input asp-for="BriefDetails!.ImageUrlExist" name="ImageUrlExist" class="form-check-input" type="radio" id="otrosarchivosno" value="false">
                                <label class="form-check-label" for="otro">No</label>
                            </div>
                            <div>
                                <input asp-for="BriefDetails!.FileOtros" type="file" id="otrosarchivosInput" class="form-control mt-2" onchange="OtrosArchivos(event)" />
                                <div class="mt-3">
                                    <img src="" id="otrosarchivosview" class="w-25 img-thumbnail" />
                                </div>
                            </div>
                        }
                    </div>

                </fieldset>

            </div>

        </div>
        <div class="card-footer text-muted">

            <a asp-page="/Briefs/Client/Rechazadas" class="btn btn-secondary"><i class="bi bi-x-circle" style="color:white"></i> Cancelar</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle" style="color:white"></i> Actualizar</button>

        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @* //scripts para mostrar imagen previa *@

    <script type="text/javascript">
        function DisplayArchivosCostos(event) {
            var archivosCostosInput = document.getElementById('archivoscostosInput');
            var archivosCostosView = document.getElementById('archivoscostosview');

            archivosCostosView.src = URL.createObjectURL(archivosCostosInput.files[0]);
        }
    </script>

    <script type="text/javascript">
        function DisplayArchivosDesign(event) {
            var archivosDesignInput = document.getElementById('archivosdesignInput');
            var archivosDesignView = document.getElementById('archivosdesignview');

            archivosDesignView.src = URL.createObjectURL(archivosDesignInput.files[0]);
        }
    </script>

    <script type="text/javascript">
        function OtrosArchivos(event) {
            var OtrosarchivosInput = document.getElementById('otrosarchivosInput');
            var OtrosarchivosView = document.getElementById('otrosarchivosview');

            OtrosarchivosView.src = URL.createObjectURL(OtrosarchivosInput.files[0]);
        }
    </script>

    @* //scripts para archivos *@

    <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", function () {

            var ArchivosDesignInput = document.getElementById("archivosdesignInput");
            var ArchivosDesignSi = document.getElementById("archivosdesignsi");
            var ArchivosDesignNo = document.getElementById("archivosdesignno");
            var VistaArchivosDesign = document.getElementById("archivosdesignview");

            // Ocultar el campo de entrada al cargar la página
            ArchivosDesignInput.style.display = "none";
            VistaArchivosDesign.style.display = "none";

            // Verificar el estado inicial de los radios y mostrar u ocultar los campos en consecuencia
            if (ArchivosDesignSi.checked) {
                ArchivosDesignInput.style.display = "block";
                VistaArchivosDesign.style.display = "block";
            }
            else {
                ArchivosDesignInput.style.display = "none";
                VistaArchivosDesign.style.display = "none";
            }

            // Manejar eventos de cambio en los radios
            ArchivosDesignSi.addEventListener("change", function () {
                // Mostrar u ocultar el campo de entrada de imagen y la vista de imagen
                ArchivosDesignInput.style.display = this.checked ? "block" : "none";
                VistaArchivosDesign.style.display = this.checked ? "block" : "none";
            });

            ArchivosDesignNo.addEventListener("change", function () {
                // Mostrar u ocultar el campo de entrada de imagen y la vista de imagen
                ArchivosDesignInput.style.display = this.checked ? "none" : "block";
                VistaArchivosDesign.style.display = this.checked ? "none" : "block";
            });
        });
    </script>

