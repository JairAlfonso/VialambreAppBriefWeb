@page
@using VialambreAppTest1.Models;
@model VialambreAppTest1.Pages.Briefs.Client.BriefReenviadoReadOnlyModel
@{
    List<Pieza> PiezasAsociadas = Model!.PiezasAsociadas!;
}

<div class="card w-80 shadow-lg mt-3" style="margin:auto">

    <div class="card-header bg-info text-white" style="font-weight:bold;">

        <span style="font-size: 25px;">Consecutivo del brief: @Model!.BriefDetails!.Consecutivo</span>

    </div>


    @if (Model.BriefDetails != null)
    {
        <div class="card-body">

            <div class="row">

                <div class="divider-line mt-2">
                    <h5>Información del cliente</h5>
                </div>

                <fieldset class="col-sm-6">

                    <div class="mt-1">
                        <label for="ClientFullName">Nombre:</label>
                        <input type="text" id="ClientFullName" class="form-control mt-2" value="@Model.BriefDetails!.ClientFullName" disabled />
                    </div>

                </fieldset>

                <fieldset class="col-sm-6">

                    <div class="mt-1">
                        <label for="ClientDocument">NIT/ID:</label>
                        <input type="text" id="ClientDocument" class="form-control mt-2" value="@Model.BriefDetails!.ClientDocument" disabled />
                    </div>

                </fieldset>

                <div class="divider-line mt-5">
                    <h5>Detalles del brief</h5>
                </div>

                <fieldset class="col-sm-6">

                    <div class="row">

                        <fieldset class="col-sm-6">
                            <div class="mt-1">
                                <label for="TipoCotizacion">Tipo de cotización:</label>
                                <input type="text" id="tipoCotizacion" class="form-control mt-1" value="@Model.BriefDetails!.TipoCotizacion" disabled />
                            </div>

                        </fieldset>

                        <fieldset class="col-sm-6">
                            <div class="mt-1">
                                <label for="FechaCreado">Fecha creado:</label>
                                <input type="text" id="tipoCotizacion" class="form-control mt-1" value="@Model.BriefDetails!.CreateDate.ToString("dd/MM/yyyy hh:mm tt")" disabled />
                            </div>
                        </fieldset>

                    </div>

                    <div class="row">

                        <fieldset class="col-sm-6">

                            <div class="mt-2">
                                <label for="Titulo">Nombre de la campaña:</label>
                                <input type="text" class="form-control mt-1" value="@Model.BriefDetails!.Title" disabled />
                            </div>

                        </fieldset>

                        <fieldset class="col-sm-6">

                            <div class="mt-2">
                                <label for="Marca">Nombre de marca:</label>
                                <input type="text" class="form-control mt-1" value="@Model.BriefDetails!.Marca" disabled />
                            </div>

                        </fieldset>

                    </div>

                    <div class="mt-2">
                        <label for="Description">Descripción:</label>
                        <textarea rows="4" class="form-control mt-1" disabled>@Model.BriefDetails!.Description</textarea>
                    </div>

                    <div class="row">

                        <fieldset class="col-sm-4">

                            <div class="mt-2">
                                <label for="Producto">Producto:</label>
                                <input class="form-control mt-1" value="@Model.BriefDetails!.Producto" disabled />
                            </div>

                        </fieldset>

                        <fieldset class="col-sm-4">

                            <div class="mt-2">
                                <label for="FechaRequerida">Fecha requerida:</label>
                                <input type="text" class="form-control mt-1" value="@Model.BriefDetails!.FechaRequerida.ToString("dd/MM/yyyy")" disabled />
                            </div>

                        </fieldset>

                        <fieldset class="col-sm-4">

                            <div class="mt-2">
                                <label for="EntregarEn">Entregar en:</label>
                                <input type="text" class="form-control mt-1" value="@Model.BriefDetails!.EntregarEn" disabled />
                            </div>

                        </fieldset>

                    </div>

                    <div class="mt-3">
                        <label for="ComentariosAdicionales">Comentarios adicionales:</label>
                        <textarea rows="3" class="form-control mt-1" disabled>@Model.BriefDetails!.ComentariosAdicionales</textarea>
                    </div>

                </fieldset>

                <fieldset class="col-sm-6 mb-4">

                    <div class="row">

                        <fieldset class="col-sm-6">

                            <div class="mt-1">
                                @if (Model.BriefDetails.Design == true)
                                {
                                    <label for="Design">Diseño: Si</label>
                                    <input type="text" class="form-control mt-1" value="@Model.BriefDetails!.StatusDesign" disabled />
                                }
                                else
                                {
                                    <label for="Design">Diseño: No</label>
                                    <input type="text" class="form-control mt-1" value="@Model.BriefDetails!.StatusDesign" disabled />
                                }
                            </div>

                        </fieldset>
                        <fieldset class="col-sm-6">

                            <div class="mt-1">
                                @if (Model.BriefDetails.Costos == true)
                                {
                                    <label for="Costos">Costos: Si</label>
                                    <input type="text" class="form-control mt-1" value="@Model.BriefDetails!.StatusCostos" disabled />
                                }
                                else
                                {
                                    <label for="Costos">Costos: No</label>
                                    <input type="text" class="form-control mt-1" value="@Model.BriefDetails!.StatusCostos" disabled />
                                }
                            </div>

                        </fieldset>

                        <fieldset class="col-sm-6">

                            <div class="mt-1">
                                <label for="Linea">Linea:</label>
                                <input type="text" class="form-control mt-1" value="@Model.BriefDetails!.Linea" disabled />
                            </div>

                        </fieldset>

                    </div>

                    <div class="row">

                        <fieldset class="col-sm-6">

                            <div class="mt-2">
                                @if (Model.BriefDetails.EsCantidadUnica == true)
                                {
                                    <label for="Unidades">Unidades:</label>
                                    <input type="text" class="form-control mt-1" value="@Model.BriefDetails!.UnidadesInput" disabled />
                                }
                                else if (Model.BriefDetails.EsEscala == true)
                                {
                                    <label for="Escala">Escala:</label>
                                    <input type="text" class="form-control mt-1" value="@Model.BriefDetails!.EscalaInput" disabled />
                                }
                            </div>
                        </fieldset>

                        <fieldset class="col-sm-6">
                            <div class="mt-2">
                                @if (Model.BriefDetails.Instalacion == true)
                                {
                                    <label for="DireccionInstalacion" class="mt-1">Dirección de instalación:</label>
                                    <input type="text" class="form-control " value="@Model.BriefDetails!.DireccionInstalacion" disabled />
                                }
                                else
                                {
                                    <label for="DireccionInstalacion" class="mt-1">Dirección de instalación:</label>
                                    <input type="text" class="form-control " value="@Model.BriefDetails!.DireccionInstalacion" disabled />
                                }
                            </div>
                        </fieldset>

                    </div>

                    <div class="row">

                        <fieldset class="col-sm-6">

                            <div class="mt-2">
                                @if (Model.BriefDetails.EsCanalVenta == true)
                                {
                                    <label for="CanalVenta" class="mt-1">Canal de venta:</label>
                                    <input type="text" class="form-control mt-1" value="@Model.BriefDetails!.CanalVentaInput" disabled />
                                }
                                else
                                {
                                    <label for="CanalVenta" class="mt-1">Canal de venta:</label>
                                    <input type="text" class="form-control " value="@Model.BriefDetails!.CanalVenta" disabled />
                                }
                            </div>

                        </fieldset>

                        <fieldset class="col-sm-6">

                            <div class="mt-2">
                                <div>
                                    <label for="presupuesto">Presupuesto por unidad:</label>
                                </div>
                                <div class="mt-1">
                                    <input type="text" class="form-control" value="$ @Model.BriefDetails!.PresupuestoUnidad" disabled />
                                </div>
                            </div>
                            <div class="mt-2">
                                <div>
                                    <label for="valorTotalCotizado">Valor total cotizado:</label>
                                </div>
                                <div class="mt-1">
                                    <input type="text" class="form-control" value="$ @Model.BriefDetails!.ValorTotalCotizado" disabled />
                                </div>
                            </div>

                        </fieldset>

                    </div>

                    <div class="mt-2">
                        <label for="TipoEmpaque">Tipo de empaque:</label>
                        <input type="text" class="form-control mt-1" value="@Model.BriefDetails!.TipoEmpaque" disabled />
                    </div>

                    <div class="divider-line mt-3">
                        <h5>Información suministrada por el cliente:</h5>
                    </div>

                    <div class="mt-2">
                        @{
                            List<string> trueValues = new List<string>();

                            if (Model.BriefDetails.KeyVisual == true)
                            {
                                trueValues.Add("KeyVisual");
                            }
                            if (Model.BriefDetails.Artes == true)
                            {
                                trueValues.Add("Artes");
                            }
                            if (Model.BriefDetails.Planos == true)
                            {
                                trueValues.Add("Planos");
                            }
                            if (Model.BriefDetails.Logos == true)
                            {
                                trueValues.Add("Logos");
                            }
                            if (Model.BriefDetails.ManualMarca == true)
                            {
                                trueValues.Add("ManualMarca");
                            }
                            if (Model.BriefDetails.Boceto == true)
                            {
                                trueValues.Add("Boceto");
                            }
                            if (Model.BriefDetails.MuestraFisica == true)
                            {
                                trueValues.Add("MuestraGrafica");
                            }
                            if (Model.BriefDetails.ImagenReferencia == true)
                            {
                                trueValues.Add("ImagenReferencia");
                            }
                            if (Model.BriefDetails.Ninguna == true)
                            {
                                trueValues.Add("Ninguna");
                            }
                        }

                        <textarea class="form-control mt-1" rows="1" disabled>@string.Join(", ", trueValues)</textarea>

                    </div>

                    <div class="mt-3">

                        <label>Archivos para costos:</label>

                        @if (Model.BriefDetails.ArchivosCostosExist == true && Model.BriefDetails.ArchivosCostos != null)
                        {
                            if (Model!.BriefDetails!.ArchivosCostos!.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
                            Model!.BriefDetails!.ArchivosCostos!.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
                            Model!.BriefDetails!.ArchivosCostos!.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ||
                            Model!.BriefDetails!.ArchivosCostos!.EndsWith(".gif", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="bi bi-image-fill"></i>
                                //<a href="@Model!.BriefDetails!.ArchivosCostos" target="_blank">Ver imagen</a>
                                <a href="~/@Model!.BriefDetails!.ArchivosCostos" target="_blank">Ver imagen</a>
                            }
                            else if (Model!.BriefDetails!.ArchivosCostos!.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="bi bi-file-earmark-pdf-fill"></i>
                                //<a href="@Model!.BriefDetails!.ArchivosCostos" target="_blank">Ver archivo</a>
                                <a href="~/@Model!.BriefDetails!.ArchivosCostos" target="_blank">Ver archivo</a>
                            }
                            else if (Model!.BriefDetails!.ArchivosCostos!.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase) ||
                            Model!.BriefDetails!.ArchivosCostos!.EndsWith(".xls", StringComparison.OrdinalIgnoreCase) ||
                            Model!.BriefDetails!.ArchivosCostos!.EndsWith(".docx", StringComparison.OrdinalIgnoreCase) ||
                            Model!.BriefDetails!.ArchivosCostos!.EndsWith(".doc", StringComparison.OrdinalIgnoreCase) || Model!.BriefDetails!.ArchivosCostos!.EndsWith(".txt", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="bi bi-file-earmark-text-fill"></i>
                                //<a href="@Model!.BriefDetails!.ArchivosCostos" target="_blank">Descargar</a>
                                <a href="~/@Model!.BriefDetails!.ArchivosCostos" target="_blank">Descargar</a>
                            }
                            else if (Model!.BriefDetails!.ArchivosCostos!.EndsWith(".zip", StringComparison.OrdinalIgnoreCase) || Model!.BriefDetails!.ArchivosCostos!.EndsWith(".rar", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="bi bi-file-zip-fill"></i>
                                //<a href="@Model!.BriefDetails!.ArchivosCostos" target="_blank">Descargar</a>
                                <a href="~/@Model!.BriefDetails!.ArchivosCostos" target="_blank">Descargar</a>
                            }
                            else
                            {
                                <i class="bi bi-question-square"></i>
                                //<a href="@Model!.BriefDetails!.ArchivosCostos" target="_blank">Descargar</a>
                                <a href="~/@Model!.BriefDetails!.ArchivosCostos" target="_blank">Descargar</a>
                            }
                        }
                        else
                        {
                            <i class="bi bi-file-earmark-excel-fill"></i>
                            <span>Sin archivo</span>
                        }
                    </div>

                    <div class="mt-2">

                        <label>Archivos para diseño:</label>

                        @if (Model.BriefDetails.ArchivosDesignExist == true && Model.BriefDetails.ArchivosDesign != null)
                        {
                            if (Model!.BriefDetails!.ArchivosDesign!.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
                            Model!.BriefDetails!.ArchivosDesign!.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
                            Model!.BriefDetails!.ArchivosDesign!.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ||
                            Model!.BriefDetails!.ArchivosDesign!.EndsWith(".gif", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="bi bi-image-fill"></i>
                                //<a href="@Model!.BriefDetails!.ArchivosDesign" target="_blank">Ver imagen</a>
                                <a href="~/@Model!.BriefDetails!.ArchivosDesign" target="_blank">Ver imagen</a>
                            }
                            else if (Model!.BriefDetails!.ArchivosDesign!.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="bi bi-file-earmark-pdf-fill"></i>
                                //<a href="@Model!.BriefDetails!.ArchivosDesign" target="_blank">Ver archivo</a>
                                <a href="~/@Model!.BriefDetails!.ArchivosDesign" target="_blank">Ver archivo</a>
                            }
                            else if (Model!.BriefDetails!.ArchivosDesign!.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase) ||
                            Model!.BriefDetails!.ArchivosDesign!.EndsWith(".xls", StringComparison.OrdinalIgnoreCase) ||
                            Model!.BriefDetails!.ArchivosDesign!.EndsWith(".docx", StringComparison.OrdinalIgnoreCase) ||
                            Model!.BriefDetails!.ArchivosDesign!.EndsWith(".doc", StringComparison.OrdinalIgnoreCase) || Model!.BriefDetails!.ArchivosDesign!.EndsWith(".txt", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="bi bi-file-earmark-text-fill"></i>
                                //<a href="@Model!.BriefDetails!.ArchivosDesign" target="_blank">Descargar</a>
                                <a href="~/@Model!.BriefDetails!.ArchivosDesign" target="_blank">Descargar</a>
                            }
                            else if (Model!.BriefDetails!.ArchivosDesign!.EndsWith(".zip", StringComparison.OrdinalIgnoreCase) || Model!.BriefDetails!.ArchivosDesign!.EndsWith(".rar", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="bi bi-file-zip-fill"></i>
                                //<a href="@Model!.BriefDetails!.ArchivosDesign" target="_blank">Descargar</a>
                                <a href="~/@Model!.BriefDetails!.ArchivosDesign" target="_blank">Descargar</a>
                            }
                            else
                            {
                                <i class="bi bi-question-square"></i>
                                //<a href="@Model!.BriefDetails!.ArchivosDesign" target="_blank">Descargar</a>
                                <a href="~/@Model!.BriefDetails!.ArchivosDesign" target="_blank">Descargar</a>
                            }
                        }
                        else
                        {
                            <i class="bi bi-file-earmark-excel-fill"></i>
                            <span>Sin archivo</span>
                        }
                    </div>

                    <div class="mt-2">

                        <label>Otros archivos:</label>

                        @if (Model.BriefDetails.ImageUrlExist == true && Model.BriefDetails.ImageUrl != null)
                        {
                            if (Model!.BriefDetails!.ImageUrl!.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
                            Model!.BriefDetails!.ImageUrl!.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
                            Model!.BriefDetails!.ImageUrl!.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ||
                            Model!.BriefDetails!.ImageUrl!.EndsWith(".gif", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="bi bi-image-fill"></i>
                                //<a href="@Model!.BriefDetails!.ImageUrl" target="_blank">Ver imagen</a>
                                <a href="~/@Model!.BriefDetails!.ImageUrl" target="_blank">Ver imagen</a>
                            }
                            else if (Model!.BriefDetails!.ImageUrl!.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="bi bi-file-earmark-pdf-fill"></i>
                                //<a href="@Model!.BriefDetails!.ImageUrl" target="_blank">Ver archivo</a>
                                <a href="~/@Model!.BriefDetails!.ImageUrl" target="_blank">Ver archivo</a>
                            }
                            else if (Model!.BriefDetails!.ImageUrl!.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase) ||
                            Model!.BriefDetails!.ImageUrl!.EndsWith(".xls", StringComparison.OrdinalIgnoreCase) ||
                            Model!.BriefDetails!.ImageUrl!.EndsWith(".docx", StringComparison.OrdinalIgnoreCase) ||
                            Model!.BriefDetails!.ImageUrl!.EndsWith(".doc", StringComparison.OrdinalIgnoreCase) || Model!.BriefDetails!.ImageUrl!.EndsWith(".txt", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="bi bi-file-earmark-text-fill"></i>
                                //<a href="@Model!.BriefDetails!.ImageUrl" target="_blank">Descargar</a>
                                <a href="~/@Model!.BriefDetails!.ImageUrl" target="_blank">Descargar</a>
                            }
                            else if (Model!.BriefDetails!.ImageUrl!.EndsWith(".zip", StringComparison.OrdinalIgnoreCase) || Model!.BriefDetails!.ImageUrl!.EndsWith(".rar", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="bi bi-file-zip-fill"></i>
                                //<a href="@Model!.BriefDetails!.ImageUrl" target="_blank">Descargar</a>
                                <a href="~/@Model!.BriefDetails!.ImageUrl" target="_blank">Descargar</a>
                            }
                            else
                            {
                                <i class="bi bi-question-square"></i>
                                //<a href="@Model!.BriefDetails!.ImageUrl" target="_blank">Descargar</a>
                                <a href="~/@Model!.BriefDetails!.ImageUrl" target="_blank">Descargar</a>
                            }
                        }
                        else
                        {
                            <i class="bi bi-file-earmark-excel-fill"></i>
                            <span>Sin archivo</span>
                        }
                    </div>

                </fieldset>

                @if (PiezasAsociadas != null && PiezasAsociadas.Any())
                {
                    <div class="card-body">

                        <div class="row">

                            @foreach (var pieza in PiezasAsociadas)
                            {
                                <div class="divider-line" style="display: flex; justify-content: space-between; align-items: center;">
                                    <h5>Pieza <span>@pieza.NumeroPieza</span></h5>
                                    <div>
                                        <a asp-page="/Briefs/Client/EditarPiezaReenviada" asp-route-briefid="@Model.BriefDetails.BriefId" asp-route-numPieza="@pieza.NumeroPieza"><i class="bi bi-pencil-fill" style="color:black"></i></a>
                                        @if (pieza.NumeroPieza == PiezasAsociadas.Max(p => p.NumeroPieza))
                                        {
                                            <a asp-page-handler="DeletePieza" asp-route-briefid="@Model.BriefDetails.BriefId" asp-route-numPieza="@pieza.NumeroPieza"><i class="bi bi-trash3-fill" style="color:black"></i></a>
                                        }
                                    </div>
                                </div>

                                <fieldset class="col-sm-6">

                                    <div class="row">

                                        <div class="col-sm-4 mt-1">
                                            <label for="PiezaName">Nombre de la pieza:</label>
                                            <input type="text" id="piezaname" class="form-control mt-2" value="@pieza.PiezaName" disabled />
                                        </div>

                                        <div class="col-sm-4 mt-1">
                                            <label for="CantidadPiezas">Cantidad:</label>
                                            <input type="text" id="cantidadpiezas" class="form-control mt-2" value="@pieza.CantidadPiezas" disabled />
                                        </div>

                                        <div class="col-sm-4 mt-1">
                                            <label for="Cargue">Cargue pieza (Kg):</label>
                                            <input type="text" id="cargue" class="form-control mt-2" value="@pieza.Cargue" disabled />
                                        </div>

                                    </div>

                                    <div class="row">

                                        <fieldset class="col-sm-6">

                                            <div class="mt-2">

                                                <div class="mt-3">

                                                    <div class="divider-line">
                                                        <h5>Material:</h5>
                                                    </div>

                                                    <div class="mt-3">
                                                        @{
                                                            List<string> materiales = new List<string>();

                                                            if (pieza.Tubo == true)
                                                            {
                                                                materiales.Add("Tubo");
                                                            }
                                                            if (pieza.Alambre == true)
                                                            {
                                                                materiales.Add("Alambre");
                                                            }
                                                            if (pieza.Lamina == true)
                                                            {
                                                                materiales.Add("Lamina");
                                                            }
                                                            if (pieza.Madera == true)
                                                            {
                                                                materiales.Add("Madera");
                                                            }
                                                            if (pieza.Formica == true)
                                                            {
                                                                materiales.Add("Formica");
                                                            }
                                                            if (pieza.Polietileno == true)
                                                            {
                                                                materiales.Add("Polietileno");
                                                            }
                                                            if (pieza.Acrilico == true)
                                                            {
                                                                materiales.Add("Acrilico");
                                                            }
                                                            if (pieza.Ps == true)
                                                            {
                                                                materiales.Add("PS");
                                                            }
                                                            if (pieza.Pp == true)
                                                            {
                                                                materiales.Add("PP");
                                                            }
                                                            if (pieza.Mdf == true)
                                                            {
                                                                materiales.Add("MDF");
                                                            }
                                                            if (pieza.NingunMaterial == true)
                                                            {
                                                                materiales.Add("Ninguno");
                                                            }
                                                            if (pieza.MaterialInput != null)
                                                            {
                                                                materiales.Add(pieza.MaterialInput);
                                                            }
                                                        }

                                                        @* <input class="form-control mt-2" disabled value="@string.Join(", ", materiales)" /> *@

                                                        <textarea class="form-control mt-1" rows="2" disabled>@string.Join(", ", materiales)</textarea>

                                                    </div>

                                                </div>

                                                <div class="divider-line mt-3">
                                                    <h5>Acabados y accesorios:</h5>
                                                </div>

                                                <div class="mt-2">
                                                    @{
                                                        List<string> accesorios = new List<string>();

                                                        if (pieza.Ruedas == true)
                                                        {
                                                            accesorios.Add("Ruedas");
                                                        }
                                                        if (pieza.Niveladores == true)
                                                        {
                                                            accesorios.Add("Niveladores");
                                                        }
                                                        if (pieza.Cromado == true)
                                                        {
                                                            accesorios.Add("Cromado");
                                                        }
                                                        if (pieza.Zincado == true)
                                                        {
                                                            accesorios.Add("Zincado");
                                                        }
                                                        if (pieza.NingunAccesorio == true)
                                                        {
                                                            accesorios.Add("Ninguno");
                                                        }
                                                        if (pieza.AcabadosyAccesoriosInput != null)
                                                        {
                                                            accesorios.Add(pieza.AcabadosyAccesoriosInput);
                                                        }

                                                    }

                                                    <textarea class="form-control mt-1" rows="2" disabled>@string.Join(", ", accesorios)</textarea>

                                                </div>

                                            </div>

                                        </fieldset>

                                        <fieldset class="col-sm-6">

                                            <div class="divider-line mt-3">
                                                <h5>Medidas:</h5>
                                            </div>

                                            <div class="row mt-1">
                                                <div class="col-sm-4">
                                                    <div class="form-group">
                                                        <label for="PiezaAlto">Alto:</label>
                                                        <input type="text" id="piezaalto" class="form-control mt-1" value="@pieza.PiezaAlto" disabled />
                                                    </div>
                                                </div>
                                                <div class="col-sm-4">
                                                    <div class="form-group">
                                                        <label for="PiezaAncho">Ancho:</label>
                                                        <input type="text" id="piezaancho" class="form-control mt-1" value="@pieza.PiezaAncho" disabled />
                                                    </div>
                                                </div>
                                                <div class="col-sm-4">
                                                    <div class="form-group">
                                                        <label for="PiezaFondo">Fondo:</label>
                                                        <input type="text" id="piezafondo" class="form-control mt-1" value="@pieza.PiezaFondo" disabled />
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="divider-line mt-3">
                                                <h5>Imagen de referencia:</h5>
                                            </div>

                                            <div>

                                                @if (!string.IsNullOrEmpty(pieza.ArchivoPieza))
                                                {
                                                    if (pieza.ArchivoPieza.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
                                                    pieza.ArchivoPieza.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
                                                    pieza.ArchivoPieza.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ||
                                                    pieza.ArchivoPieza.EndsWith(".gif", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <i class="bi bi-file-image"></i>
                                                        //<a href="@Model!.BriefDetails!.RespuestaCostosInput" target="_blank">Ver imagen</a>
                                                        <a href="@Url.Content("~/" + pieza.ArchivoPieza)" target="_blank">Ver imagen</a>
                                                    }
                                                    else if (pieza.ArchivoPieza.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <i class="bi bi-file-earmark-pdf-fill"></i>
                                                        //<a href="@pieza.ArchivoPieza target="_blank">Ver archivo</a>
                                                        <a href="@Url.Content("~/" + pieza.ArchivoPieza)" target="_blank">Ver archivo</a>
                                                    }
                                                    else if (pieza.ArchivoPieza.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase) ||
                                                    pieza.ArchivoPieza.EndsWith(".xls", StringComparison.OrdinalIgnoreCase) ||
                                                    pieza.ArchivoPieza.EndsWith(".docx", StringComparison.OrdinalIgnoreCase) ||
                                                    pieza.ArchivoPieza.EndsWith(".doc", StringComparison.OrdinalIgnoreCase) || pieza.ArchivoPieza.EndsWith(".txt", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <i class="bi bi-file-earmark-text-fill"></i>
                                                        //<a href="@pieza.ArchivoPieza target="_blank">Descargar</a>
                                                        <a href="@Url.Content("~/" + pieza.ArchivoPieza)" target="_blank">Descargar</a>
                                                    }
                                                    else if (pieza.ArchivoPieza.EndsWith(".zip", StringComparison.OrdinalIgnoreCase) || pieza.ArchivoPieza.EndsWith(".rar", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <i class="bi bi-file-earmark-zip-fill"></i>
                                                        //<a href="@pieza.ArchivoPieza target="_blank">Descargar</a>
                                                        <a href="@Url.Content("~/" + pieza.ArchivoPieza)" target="_blank">Descargar</a>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-question-square"></i>
                                                        //<a href="@pieza.ArchivoPieza target="_blank">Descargar</a>
                                                        <a href="@Url.Content("~/" + pieza.ArchivoPieza)" target="_blank">Descargar</a>
                                                    }
                                                }
                                                else
                                                {
                                                    <i class="bi bi-file-earmark-excel-fill"></i>
                                                    <span>Sin archivo adjunto</span>
                                                }

                                                <div>
                                                    <img src="@Url.Content("~/" + pieza.ArchivoPieza)" alt="Imagen de la Pieza" class="img-fluid" />
                                                </div>

                                            </div>


                                        </fieldset>

                                    </div>

                                </fieldset>

                                <fieldset class="col-sm-6 mb-5">

                                    <div>

                                        @if (pieza.Publicidad == true)
                                        {
                                            <div class="divider-line">
                                                <h5>Contiene publicidad: Si</h5>
                                            </div>
                                        }
                                        else if (pieza.Publicidad == false)
                                        {
                                            <div class="divider-line">
                                                <h5>Contiene publicidad: No</h5>
                                            </div>
                                        }

                                        <div id="medidaspublicidad" class="mt-1">

                                            <div class="row">

                                                <div class="col-sm-6">
                                                    <label for="publicidadalto">Item:</label>
                                                    <input type="text" id="publicidadalto" class="form-control" value="@pieza.Item1name" disabled />
                                                </div>

                                                <div class="col-sm-3">
                                                    <div class="form-group">
                                                        <label for="publicidadancho">Ancho:</label>
                                                        <input type="text" id="publicidadancho" class="form-control" value="@pieza.Item1Ancho" disabled />
                                                    </div>
                                                </div>

                                                <div class="col-sm-3">
                                                    <div class="form-group">
                                                        <label for="publicidadalto">Alto:</label>
                                                        <input type="text" id="publicidadalto" class="form-control" value="@pieza.Item1Alto" disabled />
                                                    </div>
                                                </div>

                                            </div>

                                            <div class="row">

                                                <div class="col-sm-6 mt-1">
                                                    <input type="text" id="publicidadalto" class="form-control" value="@pieza.Item2name" disabled />
                                                </div>

                                                <div class="col-sm-3 mt-1">
                                                    <div class="form-group">
                                                        <input type="text" id="publicidadancho" class="form-control" value="@pieza.Item2Ancho" disabled />
                                                    </div>
                                                </div>

                                                <div class="col-sm-3 mt-1">
                                                    <div class="form-group">
                                                        <input type="text" id="publicidadalto" class="form-control" value="@pieza.Item2Alto" disabled />
                                                    </div>
                                                </div>

                                            </div>

                                            <div class="row">

                                                <div class="col-sm-6 mt-1">

                                                    <input type="text" id="publicidadalto" class="form-control" value="@pieza.Item3name" disabled />
                                                </div>

                                                <div class="col-sm-3 mt-1">
                                                    <div class="form-group">

                                                        <input type="text" id="publicidadancho" class="form-control" value="@pieza.Item3Ancho" disabled />
                                                    </div>
                                                </div>

                                                <div class="col-sm-3 mt-1">
                                                    <div class="form-group">

                                                        <input type="text" id="publicidadalto" class="form-control" value="@pieza.Item3Alto" disabled />
                                                    </div>
                                                </div>

                                            </div>

                                            <div class="row">

                                                <div class="col-sm-6 mt-1">

                                                    <input type="text" id="publicidadalto" class="form-control" value="@pieza.Item4name" disabled />
                                                </div>

                                                <div class="col-sm-3 mt-1">
                                                    <div class="form-group">
                                                        <input type="text" id="publicidadancho" class="form-control" value="@pieza.Item4Ancho" disabled />
                                                    </div>
                                                </div>

                                                <div class="col-sm-3 mt-1">
                                                    <div class="form-group">
                                                        <input type="text" id="publicidadalto" class="form-control" value="@pieza.Item4Alto" disabled />
                                                    </div>
                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                    <div class="row">

                                        <div class="col-sm-6 mt-2">
                                            <label for="Tintas">Tíntas:</label>
                                            <input type="text" id="tintas" class="form-control mt-1" value="@pieza.Tintas" disabled />
                                        </div>

                                        <div class="col-sm-6 mt-2">
                                            <label for="Color">Color:</label>
                                            <input type="text" id="color" class="form-control mt-1" value="@pieza.Color" disabled />
                                        </div>

                                    </div>

                                    <div class="row">

                                        <fieldset class="col-sm-6">

                                            <div class="divider-line mt-2">
                                                <h5>Acabados:</h5>
                                            </div>

                                            <div class="mt-1">
                                                @{
                                                    List<string> acabados = new List<string>();

                                                    if (pieza.Laminado == true)
                                                    {
                                                        acabados.Add("Laminado");
                                                    }
                                                    if (pieza.Refilado == true)
                                                    {
                                                        acabados.Add("Refilado");
                                                    }
                                                    if (pieza.Troquelado == true)
                                                    {
                                                        acabados.Add("Troquelado");
                                                    }
                                                    if (pieza.Termodoblado == true)
                                                    {
                                                        acabados.Add("Termodoblado");
                                                    }
                                                    if (pieza.Termoformado == true)
                                                    {
                                                        acabados.Add("Termoformado");
                                                    }
                                                    if (pieza.NingunAcabado == true)
                                                    {
                                                        acabados.Add("Ninguno");
                                                    }
                                                    if (pieza.AcabadoInput != null)
                                                    {
                                                        acabados.Add(pieza.AcabadoInput);
                                                    }

                                                }

                                                <textarea class="form-control mt-1" rows="2" disabled>@string.Join(", ", acabados)</textarea>

                                            </div>

                                        </fieldset>

                                        <fieldset class="col-sm-6">

                                            <div class="divider-line mt-2">
                                                <h5>Comentarios adicionales:</h5>
                                            </div>

                                            <div class="mt-1">
                                                <textarea class="form-control mt-1" rows="2" disabled>@pieza.ComentariosAdicionales</textarea>
                                            </div>

                                        </fieldset>
                                    </div>

                                </fieldset>

                            }

                        </div>

                    </div>
                }
                else
                {
                    <p>*No hay piezas asociadas a este brief.</p>
                }

            </div>

        </div>

        <div class="card-footer text-muted p-2">
            <!-- Botón agregar pieza -->
            <a asp-route-briefid="@Model.BriefDetails.BriefId" asp-page="AgregarPiezaReenviada" class="btn btn-primary"><i class="bi bi-plus-circle" style="color:white"></i> Agregar pieza</a>

            <!-- Botón Editar  -->
            <a asp-route-id="@Model.BriefDetails.BriefId" asp-page="Reenviar" class="btn btn-success"><i class="bi bi-pencil" style="color:white"></i> Editar brief</a>

            @if (PiezasAsociadas != null && PiezasAsociadas.Any())
            {
                <!-- Botón finalizar (visible solo si la pieza ya se guardó) -->
                @if(Model.BriefDetails.FechaRespuestaCostos == null)
                {
                    <a asp-page-handler="ReenviarDesign" asp-route-briefid="@Model.BriefDetails.BriefId" class="btn btn-secondary"><i class="bi bi-check-circle" style="color:white"></i> Reenviar</a>
                }
                else
                {
                    <a asp-page-handler="ReenviarCostos" asp-route-briefid="@Model.BriefDetails.BriefId" class="btn btn-secondary"><i class="bi bi-check-circle" style="color:white"></i> Reenviar</a>
                }
        }

        </div>

    }
    else
    {
        <p>El brief no existe o fue borrado de la base de datos.</p>
    }


</div>
