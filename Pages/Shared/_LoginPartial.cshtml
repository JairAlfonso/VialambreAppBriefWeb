@using Microsoft.AspNetCore.Identity;
@using VialambreAppTest1.Models;
@inject SignInManager<AppUser> _signInManager
@inject UserManager<AppUser> _userManager

<div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
    <ul class="navbar-nav" style="margin-left:auto">
        @if (_signInManager.IsSignedIn(User))
        {                                 
            <li class="nav-item dropdown mx-3">              
                <a class="btn btn-primary dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-person-circle"></i> @_userManager.GetUserAsync(User).Result.FirstName
                </a>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" asp-page="/Users/Profile" >Perfil</a></li>
                    <li><a class="dropdown-item" asp-page="/Users/ChangePassword">contraseña</a></li>
                    <li><a class="dropdown-item" asp-page="/Users/Login" asp-page-handler="LogOut">Salir</a></li>
                </ul>              
            </li>
        }
        else
        {
            @*<li class="nav-item">
                <a class="nav-link text-dark" asp-page="/Users/Register">Registrarse</a>
            </li>
            <li class="nav-item mx-2">
                <a class="nav-link text-dark" asp-page="/Users/Login">Ingresar</a>
        </li>*@
        }
    </ul>
</div>