@page
@model VialambreAppTest1.Pages.Users.ProfileModel
@{
}

<div class="card shadow-lg mx-auto mt-4" style="max-width: 400px;">
    <div class="card-header">
        <div class="row">
            <div class="col-sm-5 mt-2 mx-4">
                <h5 class="card-title fw-bold pt-2"><i class="bi bi-person-circle"> Editar perfil</i></h5>
            </div>
        </div>
    </div>
    <div class="container">
        <!-- Mensajes de éxito y advertencia -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning">
                @TempData["WarningMessage"]
            </div>
        }

        <form method="post">
            <div class="mx-auto my-3 col-xl-8">
                <input asp-for="UserInputVM!.RolName" class="form-control" value="@Model!.UserInputVM!.RolName" hidden />
                <div class="mt-1">
                    <div class="">
                        <input asp-for="UserInputVM!.FirstName" class="form-control" placeholder="Nombre" />
                    </div>
                    <span asp-validation-for="UserInputVM!.FirstName" class="text-danger"></span>
                </div>
                <div class="mt-1">
                    <div class="">
                        <input asp-for="UserInputVM!.LastName" class="form-control" placeholder="Apellido" />
                    </div>
                    <span asp-validation-for="UserInputVM!.LastName" class="text-danger"></span>
                </div>
                <div class="mt-1">
                    <div class="">
                        <input asp-for="UserInputVM!.Document" class="form-control" placeholder="Documento" />
                    </div>
                    <span asp-validation-for="UserInputVM!.Document" class="text-danger"></span>
                </div>
                <div class="mt-1">
                    <div class="">
                        <input asp-for="UserInputVM!.Email" class="form-control" placeholder="Correo electronico" />
                    </div>
                    <span asp-validation-for="UserInputVM!.Email" class="text-danger"></span>
                </div>
                <div class="mt-1">
                    <div>
                        <input asp-for="UserInputVM!.PhoneNumber" class="form-control" placeholder="Teléfono" />
                    </div>
                    <span asp-validation-for="UserInputVM!.PhoneNumber" class="text-danger"></span>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary form-control">Actualizar</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
