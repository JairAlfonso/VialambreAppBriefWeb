@page
@model VialambreAppTest1.Pages.Users.ResetPasswordModel
@{
}
<!-- Auto recuperación de contraseña -->
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<div class="d-flex justify-content-center mt-3">
    <div id="login-card"  class="card w-100 w-sm-75 w-md-50 w-lg-30 mx-2 mt-3">
        <div class="card-body">
            <h4 class="card-title text-center">Restablecer Contraseña</h4>
            <form method="post">
                <div class="mb-3">
                    <label for="email" class="custom-label">Correo Electrónico</label>
                    <input id="email" asp-for="ResetPasswordVM.Email" class="form-control" placeholder="Correo Electrónico" />
                    <span asp-validation-for="ResetPasswordVM.Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label for="newPassword" class="custom-label">Nueva Contraseña</label>
                    <input id="newPassword" asp-for="ResetPasswordVM.NewPassword" class="form-control" type="password" placeholder="Nueva Contraseña" />
                    <span asp-validation-for="ResetPasswordVM.NewPassword" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label for="confirmPassword" class="custom-label">Confirmar Contraseña</label>
                    <input id="confirmPassword" asp-for="ResetPasswordVM.ConfirmPassword" class="form-control" type="password" placeholder="Confirmar Contraseña" />
                    <span asp-validation-for="ResetPasswordVM.ConfirmPassword" class="text-danger"></span>
                </div>
                <div>
                    <input type="submit" value="Restablecer Contraseña" class="btn btn-primary w-100" />
                </div>
            </form>
        </div>
    </div>
</div>
