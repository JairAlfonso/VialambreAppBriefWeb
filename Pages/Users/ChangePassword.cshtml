@page
@model VialambreAppTest1.Pages.Users.ChangePasswordModel
@{
}

<div class="card shadow-lg mx-auto mt-4" style="max-width: 400px;">
    <div class="card-header">
        <h5 class="card-title fw-bold"><i class="bi bi-key"> Cambiar contraseña</i></h5>
    </div>
    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning">
                @TempData["WarningMessage"]
            </div>
        }

        <form method="post">
            <div class="mx-auto my-3 col-xl-8">
                <div class="mt-1">
                    <div>
                        <input asp-for="UserInputVM!.OldPassword" class="form-control" type="password" placeholder="Contraseña actual" />
                    </div>
                    <span asp-validation-for="UserInputVM!.OldPassword" class="text-danger"></span>
                </div>
                <div class="mt-1">
                    <div>
                        <input asp-for="UserInputVM!.Password" class="form-control" type="password" placeholder="Nueva contraseña" />
                    </div>
                    <span asp-validation-for="UserInputVM!.Password" class="text-danger"></span>
                </div>
                <div class="mt-1">
                    <div>
                        <input asp-for="UserInputVM!.ConfirmPassword" class="form-control" type="password" placeholder="Confirmar nueva contraseña" />
                    </div>
                    <span asp-validation-for="UserInputVM!.ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary form-control">Cambiar contraseña</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
