@page
@using VialambreAppTest1.Utility;
@model VialambreAppTest1.Pages.Users.RegisterModel
@{
}

<div class="card shadow-lg mx-auto mt-4" style="max-width: 400px;">
    <div class="card-header">
        <div class="row">
            <div class="col-sm-5 mt-2 mx-4">
                <h5 class="card-title fw-bold pt-2"><i class="bi bi-person-circle"> Registro</i></h5>
            </div>
            @* <div class="col-sm-4 p-2 mx-4">
            <a asp-page="/Index" class="btn btn-success form-control">Regresar</a>
            </div> *@
        </div>
    </div>
    <div class="container">
        <form method="post">
            <div class="mx-auto my-3 col-xl-8">

                <div class="mt-1">
                    <div class="">
                        <input asp-for="UserInputVM!.FirstName" class="form-control" placeholder="Nombre" />
                    </div>
                    <span asp-validation-for="UserInputVM!.FirstName" class="text-danger"></span>
                </div>
                <div class="mt-1">
                    <div class="">
                        <input asp-for="UserInputVM!.LastName" class="form-control" placeholder="Apellido" />
                    </div>
                    <span asp-validation-for="UserInputVM!.LastName" class="text-danger"></span>
                </div>
                <div class="mt-1">
                    <div class="">
                        <input asp-for="UserInputVM!.Document" class="form-control" placeholder="Documento" />
                    </div>
                    <span asp-validation-for="UserInputVM!.Document" class="text-danger"></span>
                </div>
                <div class="mt-1">
                    <div class="">
                        <input asp-for="UserInputVM!.Email" class="form-control" placeholder="Correo electronico" />
                    </div>
                    <span asp-validation-for="UserInputVM!.Email" class="text-danger"></span>
                </div>
                <div class="mt-1">
                    <div>
                        <input asp-for="UserInputVM!.PhoneNumber" class="form-control" placeholder="Teléfono" />
                    </div>
                    <span asp-validation-for="UserInputVM!.PhoneNumber" class="text-danger"></span>
                </div>
                <div class="mt-1">
                    <div>
                        <input id="pass" asp-for="UserInputVM!.Password" class="form-control" type="password" placeholder="Contraseña" />
                    </div>
                    <span asp-validation-for="UserInputVM!.Password" class="text-danger"></span>
                    <div class="mt-1">
                        <input id="passconfirm" asp-for="UserInputVM!.ConfirmPassword" class="form-control" type="password" placeholder="Confirmar Contraseña" />
                    </div>
                    <span asp-validation-for="UserInputVM!.ConfirmPassword" class="text-danger"></span>
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <div class="mt-2">
                        <div class="form-check form-switch">
                            <input class="form-check-input" value="@RolesApp.Admin" type="radio" name="rUserRole">
                            <label class="form-check-label">@RolesApp.Admin</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" value="@RolesApp.AdminUser" type="radio" name="rUserRole">
                            <label class="form-check-label">@RolesApp.AdminUser</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" value="@RolesApp.Costos" type="radio" name="rUserRole">
                            <label class="form-check-label">@RolesApp.Costos</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" value="@RolesApp.Design" type="radio" name="rUserRole">
                            <label class="form-check-label">@RolesApp.Design</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" value="@RolesApp.Asesor" type="radio" name="rUserRole">
                            <label class="form-check-label">@RolesApp.Asesor</label>
                        </div>
                    </div>
                }

                <div class="mt-3">
                    <input type="submit" value="Registarse" class="btn btn-primary form-control" />
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}